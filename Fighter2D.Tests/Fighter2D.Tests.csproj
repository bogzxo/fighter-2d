<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of the fight with no window. The simulation (Simulation/) runs against a fake fighter here, buttons go in,
    moves come out, the same shape as the engine's Horizon.Tests. dotnet test Fighter2D.Tests runs them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Fighter2D.Simulation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fighter2D.csproj" />
  </ItemGroup>

</Project>
