// The characters of the game, in the order the screen they are picked on shows them.
// Each has a folder of its own in Assets/sprites/characters with its sprite sheet and the definition of its animations
// in it. What a sheet was made from (the art itself, a sheet somebody else laid out) is in Art/characters, which
// isn't part of what the game loads or sends to whoever joins.
//   pretty_name:  what the character is called on screen
//   sprites:      the folder its sprite sheet and the definition of its animations are in
//   moves:        the files its moves come from. A move of a later file replaces the one of the same name from an
//                 earlier one, so a character can share most of its moves with another and change a few
//   walk_speed:   the speed it walks up to
//   frame_rate:   how many frames of animation a second its moves play at
//   scale:        how big the character is against the others, 1 if left out. All of it scales: the sprite, the body
//                 that stands on the map and what it hits and is hit by (which is read off the sprite, see CharacterBoxes)
//   stats:        what the screen the character is picked on says about it, each from 0 to 100. They are only
//                 for show: how a character really plays is up to its moves and the numbers above

let characters = {
    the_man: {
        pretty_name: "The Man",
        sprites: "Assets/sprites/characters/the_man",
        moves: {
            movement: "Assets/data/movement_moves.hor",
            fighting: "Assets/data/fighting_moves.hor"
        },
        walk_speed: 2000,
        frame_rate: 24,
        stats: {
            speed: 50,
            health: 50,
            bulk: 50,
            complexity: 50
        }
    },

    cammy: {
        pretty_name: "Cammy",
        sprites: "Assets/sprites/characters/cammy",
        moves: {
            movement: "Assets/data/movement_moves.hor",
            fighting: "Assets/data/fighting_moves.hor",
            own: "Assets/data/cammy_moves.hor"
        },
        walk_speed: 2300,
        frame_rate: 12,
        scale: 1.2,
        stats: {
            speed: 75,
            health: 40,
            bulk: 30,
            complexity: 65
        }
    }
}
