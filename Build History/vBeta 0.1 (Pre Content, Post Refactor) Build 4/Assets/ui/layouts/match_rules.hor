// Where the rules of the match are settled on, after the map is picked (MatchRulesScene.cs): one row per rule,
// what it is called on the left and what it is set to on the right. The game fills in what there is to choose from.

let panel = compositor.stack({
    background: "panel",
    padding: vec(40, 34),
    spacing: 22,
    intro: "pop",
    intro_time: 0.4
});

let title = compositor.label({ parent: panel, text: "Match Rules", text_scale: 0.6 });
let map_name = compositor.label({
    parent: panel,
    text: "on the map",
    text_scale: 0.3,
    color: vec(0.58, 0.6, 0.66, 1)
});

let rows = compositor.stack({ parent: panel, spacing: 12 });

let rounds_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let rounds_title = compositor.label({ parent: rounds_row, size: vec(200, 0), text: "Rounds to win", text_scale: 0.34, align: "left" });
let rounds = compositor.selector({ parent: rounds_row, size: vec(400, 52), text_scale: 0.3 });

let time_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let time_title = compositor.label({ parent: time_row, size: vec(200, 0), text: "Round time", text_scale: 0.34, align: "left" });
let time = compositor.selector({ parent: time_row, size: vec(400, 52), text_scale: 0.3 });

let weather_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let weather_title = compositor.label({ parent: weather_row, size: vec(200, 0), text: "Weather", text_scale: 0.34, align: "left" });
let weather = compositor.selector({ parent: weather_row, size: vec(400, 52), text_scale: 0.3 });

let btn_fight = compositor.button({ parent: panel, label: "Fight", size: vec(200, 0) });
let hint = compositor.label({
    parent: panel,
    text: "[icon:dpad] choose and change    [icon:pad_a] fight    [icon:pad_b] back",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});
