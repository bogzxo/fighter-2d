// The options screen (OptionsScene.cs). One row per option, what it is called on the left and what it is set to on the right.
// The game fills in what there is to choose from, and writes a line about whichever row the gamepad is on into the description.
// To add an option give it a row here (a label called <name>_title and a selector called <name>) and a line in OptionsScene.

let panel = compositor.stack({
    background: "panel",
    padding: vec(40, 30),
    spacing: 14,
    intro: "pop",
    intro_time: 0.3
});

let title = compositor.label({ parent: panel, text: "Options", text_scale: 0.6 });

let rows = compositor.stack({ parent: panel, spacing: 5 });

// The window
let display_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let display_title = compositor.label({ parent: display_row, size: vec(260, 0), text: "Display", text_scale: 0.3, align: "left" });
let display = compositor.selector({ parent: display_row, size: vec(380, 44), text_scale: 0.27 });

let resolution_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let resolution_title = compositor.label({ parent: resolution_row, size: vec(260, 0), text: "Resolution", text_scale: 0.3, align: "left" });
let resolution = compositor.selector({ parent: resolution_row, size: vec(380, 44), text_scale: 0.27 });

let vsync_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let vsync_title = compositor.label({ parent: vsync_row, size: vec(260, 0), text: "V-Sync", text_scale: 0.3, align: "left" });
let vsync = compositor.selector({ parent: vsync_row, size: vec(380, 44), text_scale: 0.27 });

let frame_limit_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let frame_limit_title = compositor.label({ parent: frame_limit_row, size: vec(260, 0), text: "Frame limit", text_scale: 0.3, align: "left" });
let frame_limit = compositor.selector({ parent: frame_limit_row, size: vec(380, 44), text_scale: 0.27 });

// The look
let transitions_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let transitions_title = compositor.label({ parent: transitions_row, size: vec(260, 0), text: "Scene transitions", text_scale: 0.3, align: "left" });
let transitions = compositor.selector({ parent: transitions_row, size: vec(380, 44), text_scale: 0.27 });

let crt_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let crt_title = compositor.label({ parent: crt_row, size: vec(260, 0), text: "CRT screen", text_scale: 0.3, align: "left" });
let crt = compositor.selector({ parent: crt_row, size: vec(380, 44), text_scale: 0.27 });

let motion_blur_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let motion_blur_title = compositor.label({ parent: motion_blur_row, size: vec(260, 0), text: "Motion blur", text_scale: 0.3, align: "left" });
let motion_blur = compositor.selector({ parent: motion_blur_row, size: vec(380, 44), text_scale: 0.27 });

// The fight
let input_display_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let input_display_title = compositor.label({ parent: input_display_row, size: vec(260, 0), text: "Input display", text_scale: 0.3, align: "left" });
let input_display = compositor.selector({ parent: input_display_row, size: vec(380, 44), text_scale: 0.27 });

let hit_callouts_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let hit_callouts_title = compositor.label({ parent: hit_callouts_row, size: vec(260, 0), text: "Hit callouts", text_scale: 0.3, align: "left" });
let hit_callouts = compositor.selector({ parent: hit_callouts_row, size: vec(380, 44), text_scale: 0.27 });

let frame_data_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let frame_data_title = compositor.label({ parent: frame_data_row, size: vec(260, 0), text: "Frame data", text_scale: 0.3, align: "left" });
let frame_data = compositor.selector({ parent: frame_data_row, size: vec(380, 44), text_scale: 0.27 });

let hitboxes_row = compositor.stack({ parent: rows, direction: "horizontal", spacing: 24 });
let hitboxes_title = compositor.label({ parent: hitboxes_row, size: vec(260, 0), text: "Hitboxes", text_scale: 0.3, align: "left" });
let hitboxes = compositor.selector({ parent: hitboxes_row, size: vec(380, 44), text_scale: 0.27 });

// What the row the gamepad is on has to say for itself
let description = compositor.label({
    parent: panel,
    size: vec(664, 58),
    text: "",
    text_scale: 0.25
});

let hint = compositor.label({
    parent: panel,
    text: "[icon:dpad] choose and change    [icon:pad_b] back",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});
