// One action on the bindings screen and the button that says what it is bound to, made once per action by bindings.hor.

let row = compositor.stack({
    direction: "horizontal",
    spacing: 14,
    intro: "slide",
    intro_time: 0.3,
    intro_delay: 0.15,
    intro_offset: vec(-140, 0)
});

let action = compositor.label({ parent: row, size: vec(190, 0), text: "Action", text_scale: 0.28, align: "left" });
let binding = compositor.button({
    parent: row,
    label: "[icon:pad_a]",
    style: "button_flat",
    size: vec(400, 0),
    lbl_scale: 0.28
});
