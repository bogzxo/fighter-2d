// main_menu, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.

let menu = compositor.stack({
    pos: vec(90, -110),
    anchor: "left",
    pivot: "left",
    padding: vec(36, 32, 36, 32),
    intro: "slide",
    intro_time: 0.55,
    intro_delay: 0.2,
    intro_offset: vec(-520, 0),
    background: "panel",
    stagger: 0.1,
    spacing: 16
});

let btn_pvp = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.55,
    label: "PVP"
});

let btn_practice = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.55,
    label: "Practice"
});

let btn_host = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.55,
    label: "Host Server"
});

let btn_join = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.55,
    label: "Join Multiplayer"
});

let btn_options = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.55,
    label: "Options"
});

let hint = compositor.label({
    parent: menu,
    size: vec(0, 30),
    text: "[icon:dpad] choose    [icon:pad_a] pick    [icon:pad_b] quit",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});

let version = compositor.label({
    parent: menu,
    text: "version",
    text_scale: 0.2,
    color: vec(0.58, 0.6, 0.66, 1)
});

let logo = compositor.image({
    pos: vec(12, 0),
    size: vec(600, 288),
    anchor: "top_left",
    pivot: "top_left",
    intro: "pop",
    intro_time: 0.7,
    intro_delay: 0.15,
    file: "Assets/ui/new_logo.png"
});
