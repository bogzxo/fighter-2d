// The options screen (OptionsScene.cs). The options come in three tabs, which the bumpers flip between, and each tab
// is a list of rows: what an option is called on the left and what it is set to on the right. The game fills in what
// there is to choose from, and writes a line about whichever row the gamepad is on into the description.
// To add an option give it a row in one of the tabs (a label called <name>_title and a selector called <name>) and a
// line in OptionsScene.

let panel = compositor.stack({
    background: "panel",
    padding: vec(44, 32),
    spacing: 18,
    intro: "pop",
    intro_time: 0.3
});

let title = compositor.label({ parent: panel, text: "Options", text_scale: 0.6 });

// The tabs, the one that is open written in white (OptionsScene.cs)
let tabs = compositor.stack({ parent: panel, direction: "horizontal", spacing: 40 });
let tab_prev = compositor.label({ parent: tabs, text: "[icon:pad_lb]", text_scale: 0.3 });
let tab_display = compositor.label({ parent: tabs, size: vec(160, 0), text: "Display", text_scale: 0.36 });
let tab_look = compositor.label({ parent: tabs, size: vec(160, 0), text: "Look", text_scale: 0.36 });
let tab_fight = compositor.label({ parent: tabs, size: vec(160, 0), text: "Fight", text_scale: 0.36 });
let tab_next = compositor.label({ parent: tabs, text: "[icon:pad_rb]", text_scale: 0.3 });

// The display tab
let display_rows = compositor.stack({ parent: panel, spacing: 8, intro: "slide", intro_time: 0.25, intro_offset: vec(0, -24) });
let display_row = compositor.stack({ parent: display_rows, direction: "horizontal", spacing: 28 });
let display_title = compositor.label({ parent: display_row, size: vec(280, 0), text: "Display", text_scale: 0.32, align: "left" });
let display = compositor.selector({ parent: display_row, size: vec(400, 48), text_scale: 0.28 });
let resolution_row = compositor.stack({ parent: display_rows, direction: "horizontal", spacing: 28 });
let resolution_title = compositor.label({ parent: resolution_row, size: vec(280, 0), text: "Resolution", text_scale: 0.32, align: "left" });
let resolution = compositor.selector({ parent: resolution_row, size: vec(400, 48), text_scale: 0.28 });
let vsync_row = compositor.stack({ parent: display_rows, direction: "horizontal", spacing: 28 });
let vsync_title = compositor.label({ parent: vsync_row, size: vec(280, 0), text: "V-Sync", text_scale: 0.32, align: "left" });
let vsync = compositor.selector({ parent: vsync_row, size: vec(400, 48), text_scale: 0.28 });
let frame_limit_row = compositor.stack({ parent: display_rows, direction: "horizontal", spacing: 28 });
let frame_limit_title = compositor.label({ parent: frame_limit_row, size: vec(280, 0), text: "Frame limit", text_scale: 0.32, align: "left" });
let frame_limit = compositor.selector({ parent: frame_limit_row, size: vec(400, 48), text_scale: 0.28 });

// The look tab
let look_rows = compositor.stack({ parent: panel, spacing: 8, intro: "slide", intro_time: 0.25, intro_offset: vec(0, -24) });
let gui_scale_row = compositor.stack({ parent: look_rows, direction: "horizontal", spacing: 28 });
let gui_scale_title = compositor.label({ parent: gui_scale_row, size: vec(280, 0), text: "GUI scale", text_scale: 0.32, align: "left" });
let gui_scale = compositor.selector({ parent: gui_scale_row, size: vec(400, 48), text_scale: 0.28 });
let transitions_row = compositor.stack({ parent: look_rows, direction: "horizontal", spacing: 28 });
let transitions_title = compositor.label({ parent: transitions_row, size: vec(280, 0), text: "Scene transitions", text_scale: 0.32, align: "left" });
let transitions = compositor.selector({ parent: transitions_row, size: vec(400, 48), text_scale: 0.28 });
let crt_row = compositor.stack({ parent: look_rows, direction: "horizontal", spacing: 28 });
let crt_title = compositor.label({ parent: crt_row, size: vec(280, 0), text: "CRT screen", text_scale: 0.32, align: "left" });
let crt = compositor.selector({ parent: crt_row, size: vec(400, 48), text_scale: 0.28 });
let motion_blur_row = compositor.stack({ parent: look_rows, direction: "horizontal", spacing: 28 });
let motion_blur_title = compositor.label({ parent: motion_blur_row, size: vec(280, 0), text: "Motion blur", text_scale: 0.32, align: "left" });
let motion_blur = compositor.selector({ parent: motion_blur_row, size: vec(400, 48), text_scale: 0.28 });

// The fight tab
let fight_rows = compositor.stack({ parent: panel, spacing: 8, intro: "slide", intro_time: 0.25, intro_offset: vec(0, -24) });
let camera_zoom_row = compositor.stack({ parent: fight_rows, direction: "horizontal", spacing: 28 });
let camera_zoom_title = compositor.label({ parent: camera_zoom_row, size: vec(280, 0), text: "Camera zoom", text_scale: 0.32, align: "left" });
let camera_zoom = compositor.selector({ parent: camera_zoom_row, size: vec(400, 48), text_scale: 0.28 });
let input_display_row = compositor.stack({ parent: fight_rows, direction: "horizontal", spacing: 28 });
let input_display_title = compositor.label({ parent: input_display_row, size: vec(280, 0), text: "Input display", text_scale: 0.32, align: "left" });
let input_display = compositor.selector({ parent: input_display_row, size: vec(400, 48), text_scale: 0.28 });
let hit_callouts_row = compositor.stack({ parent: fight_rows, direction: "horizontal", spacing: 28 });
let hit_callouts_title = compositor.label({ parent: hit_callouts_row, size: vec(280, 0), text: "Hit callouts", text_scale: 0.32, align: "left" });
let hit_callouts = compositor.selector({ parent: hit_callouts_row, size: vec(400, 48), text_scale: 0.28 });
let frame_data_row = compositor.stack({ parent: fight_rows, direction: "horizontal", spacing: 28 });
let frame_data_title = compositor.label({ parent: frame_data_row, size: vec(280, 0), text: "Frame data", text_scale: 0.32, align: "left" });
let frame_data = compositor.selector({ parent: frame_data_row, size: vec(400, 48), text_scale: 0.28 });
let hitboxes_row = compositor.stack({ parent: fight_rows, direction: "horizontal", spacing: 28 });
let hitboxes_title = compositor.label({ parent: hitboxes_row, size: vec(280, 0), text: "Hitboxes", text_scale: 0.32, align: "left" });
let hitboxes = compositor.selector({ parent: hitboxes_row, size: vec(400, 48), text_scale: 0.28 });

// What the row the gamepad is on has to say for itself
let description = compositor.label({
    parent: panel,
    size: vec(708, 64),
    text: "",
    text_scale: 0.25
});

let hint = compositor.label({
    parent: panel,
    text: "[icon:dpad] choose and change    [icon:pad_lb] [icon:pad_rb] tabs    [icon:pad_b] back",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});
