// One player on the gamepad selector, made once per player by gamepad_select.hor.
// The two lines under the title are kept at a fixed size so the cards dont jump around as their texts change.

let box = compositor.stack({
    background: "button_flat",
    padding: vec(28, 26),
    spacing: 14,
    intro: "pop",
    intro_delay: 0.2
});

let title = compositor.label({ parent: box, text: "Player", text_scale: 0.45 });
let status = compositor.label({ parent: box, size: vec(400, 30), text: "press any button", text_scale: 0.3 });
let detail = compositor.label({
    parent: box,
    size: vec(400, 24),
    text: "on your gamepad",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});
