// fight_overlay, laid out with Horizon.Hex.
// Everything that is drawn over a fight. It is split over three layers so each can be hidden while another one is worked on.
// "hud" is the bars, the clock, the names, the input display and the hit callouts. "banner" calls out the rounds. "versus" is the versus screen.
// Load it with UILayout.Load, every component is there under the name it has here.

let player1_health = compositor.progress_bar({
    layer: "hud",
    pos: vec(40, -16),
    scale: vec(5, 2.75),
    anchor: "top_left",
    pivot: "top_left",
    intro: "slide",
    intro_delay: 0.4,
    intro_offset: vec(-692.75, 0),
    text_scale: 0.75
});

let player2_health = compositor.progress_bar({
    layer: "hud",
    pos: vec(-40, -16),
    scale: vec(5, 2.75),
    anchor: "top_right",
    pivot: "top_right",
    intro: "slide",
    intro_delay: 0.4,
    intro_offset: vec(642.25, 0),
    text_scale: 0.75
});

let timer_background = compositor.panel({
    layer: "hud",
    size: vec(500, 100),
    anchor: "top",
    pivot: "top",
    padding: vec(77, 18, 69.25, 17.5),
    intro: "slide",
    intro_delay: 0.35,
    intro_offset: vec(0, 148),
    background: "panel_window",
    color: vec(1, 1, 1, 0.604)
});

let timer_label = compositor.label({
    parent: timer_background,
    intro: "pop",
    intro_delay: 0.65,
    text: "99",
    text_scale: 1.25
});

// Under each bar: who the player is playing and the rounds they have taken, written by the game (HealthDisplay.cs)
let player1_info = compositor.label({
    layer: "hud",
    pos: vec(48, -92),
    size: vec(560, 34),
    anchor: "top_left",
    pivot: "top_left",
    align: "left",
    intro: "slide",
    intro_delay: 0.5,
    intro_offset: vec(-640, 0),
    text: "PLAYER ONE",
    text_scale: 0.32
});

let player2_info = compositor.label({
    layer: "hud",
    pos: vec(-48, -92),
    size: vec(560, 34),
    anchor: "top_right",
    pivot: "top_right",
    align: "right",
    intro: "slide",
    intro_delay: 0.5,
    intro_offset: vec(640, 0),
    text: "PLAYER TWO",
    text_scale: 0.32
});

// The input display down both sides. What each player held lately with the newest on top, written by the game (InputDisplay.cs)
let player1_inputs = compositor.label({
    layer: "hud",
    pos: vec(48, -150),
    size: vec(300, 430),
    anchor: "top_left",
    pivot: "top_left",
    align: "top_left",
    text: "",
    text_scale: 0.3
});

let player2_inputs = compositor.label({
    layer: "hud",
    pos: vec(-48, -150),
    size: vec(300, 430),
    anchor: "top_right",
    pivot: "top_right",
    align: "top_right",
    text: "",
    text_scale: 0.3
});

// What the last attack of each player came to (HIT, COUNTER HIT, WHIFF...) and the combo count under it, see HitCalloutDisplay.cs
let player1_callout = compositor.label({
    layer: "hud",
    pos: vec(330, -160),
    size: vec(420, 56),
    anchor: "top_left",
    pivot: "top_left",
    align: "left",
    text: "",
    text_scale: 0.6
});

let player1_combo = compositor.label({
    layer: "hud",
    pos: vec(330, -222),
    size: vec(420, 40),
    anchor: "top_left",
    pivot: "top_left",
    align: "left",
    text: "",
    text_scale: 0.42
});

let player2_callout = compositor.label({
    layer: "hud",
    pos: vec(-330, -160),
    size: vec(420, 56),
    anchor: "top_right",
    pivot: "top_right",
    align: "right",
    text: "",
    text_scale: 0.6
});

let player2_combo = compositor.label({
    layer: "hud",
    pos: vec(-330, -222),
    size: vec(420, 40),
    anchor: "top_right",
    pivot: "top_right",
    align: "right",
    text: "",
    text_scale: 0.42
});

// What is called out across the screen (ROUND 1, FIGHT!, K.O.) and the line under it, see RoundDisplay.cs
let banner = compositor.label({ layer: "banner", pos: vec(0, 150), text: "ROUND 1", text_scale: 1.7 });
let banner_detail = compositor.label({ layer: "banner", pos: vec(0, 60), text: "takes the round", text_scale: 0.4 });

// The fighters shown off against each other before the first round, see VersusDisplay.cs
let versus = compositor.stack({
    layer: "versus",
    direction: "horizontal",
    background: "panel",
    padding: vec(56, 40),
    spacing: 44,
    intro: "pop",
    intro_time: 0.35
});

let versus_p1_box = compositor.stack({ parent: versus, background: "button_flat", padding: vec(22, 20), spacing: 12 });
let versus_p1 = compositor.image({ parent: versus_p1_box, size: vec(256, 256) });
let versus_p1_name = compositor.label({ parent: versus_p1_box, size: vec(280, 34), text: "Fighter", text_scale: 0.42 });

let versus_middle = compositor.stack({ parent: versus, spacing: 14 });
let versus_title = compositor.label({ parent: versus_middle, text: "VS", text_scale: 1.6, intro: "pop", intro_delay: 0.3 });
let versus_rules = compositor.label({
    parent: versus_middle,
    text: "First to 3",
    text_scale: 0.28,
    color: vec(0.58, 0.6, 0.66, 1)
});

let versus_p2_box = compositor.stack({ parent: versus, background: "button_flat", padding: vec(22, 20), spacing: 12 });
let versus_p2 = compositor.image({ parent: versus_p2_box, size: vec(256, 256) });
let versus_p2_name = compositor.label({ parent: versus_p2_box, size: vec(280, 34), text: "Fighter", text_scale: 0.42 });
