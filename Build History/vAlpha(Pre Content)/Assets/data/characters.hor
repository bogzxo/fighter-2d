// The characters of the game, in the order the character select screen shows them.
// Each one has a folder in Assets/sprites/characters with its sprite sheet and the definition of its animations.
// The source art of a sheet is in Art/characters, which the game doesn't load and doesn't send to whoever joins.
//
//   pretty_name   what the character is called on screen
//   sprites       the folder its sprite sheet and animation definition are in
//   moves         the files its moves come from. A move in a later file replaces the one of the same name from an earlier one,
//                 so a character can share most of its moves with another and only change a few
//   walk_speed    the speed it walks up to
//   frame_rate    how many frames of animation a second its moves play at
//   scale         how big the character is against the others, 1 if left out. Everything scales with it, the sprite, the body and the hitboxes
//   stats         the bars on the character select screen, each from 0 to 100. They are only for show,
//                 how a character really plays is up to its moves and the numbers above

let characters = {
    the_man: {
        pretty_name: "The Man",
        sprites: "Assets/sprites/characters/the_man",
        moves: {
            movement: "Assets/data/movement_moves.hor",
            fighting: "Assets/data/fighting_moves.hor"
        },
        walk_speed: 2000,
        frame_rate: 24,
        stats: {
            speed: 50,
            health: 50,
            bulk: 50,
            complexity: 50
        }
    },

    cammy: {
        pretty_name: "Cammy",
        sprites: "Assets/sprites/characters/cammy",
        moves: {
            movement: "Assets/data/movement_moves.hor",
            fighting: "Assets/data/fighting_moves.hor",
            own: "Assets/data/cammy_moves.hor"
        },
        walk_speed: 2300,
        frame_rate: 12,
        scale: 1.2,
        stats: {
            speed: 75,
            health: 40,
            bulk: 30,
            complexity: 65
        }
    }
}
