// One cell of the character grid, made once per cell by character_select.hor.
// With a character in it the game shows the portrait and the name, without one the question mark.

let box = compositor.button({
    style: "button_flat",
    size: vec(168, 178),
    intro: "pop",
    intro_time: 0.3,
    intro_delay: 0.15
});

let tags = compositor.label({ parent: box, anchor: "top", pos: vec(0, -12), text: "P1", text_scale: 0.24 });
let portrait = compositor.image({ parent: box, pos: vec(0, 4), size: vec(116, 116) });
let name = compositor.label({
    parent: box,
    anchor: "bottom",
    pos: vec(0, 14),
    text: "Fighter",
    text_scale: 0.2,
    color: vec(0.58, 0.6, 0.66, 1)
});
let empty = compositor.label({ parent: box, visible: false, text: "?", text_scale: 0.6, color: vec(0.58, 0.6, 0.66, 1) });
