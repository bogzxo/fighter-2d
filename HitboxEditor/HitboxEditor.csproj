<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The hitbox editor, for drawing the hitboxes of a move by hand where the ones traced off the art aren't right.
    Built out of the game itself (its characters, their art, the box tracer and the move files), so what it shows is
    exactly what a fight goes by. Run the HitboxEditor project, see Program.cs for what it takes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>Fighter2D.HitboxEditor</RootNamespace>

    <!-- The same engine as the game's, see Fighter2D.csproj -->
    <HorizonRoot Condition="'$(HorizonRoot)' == ''">$(MSBuildThisFileDirectory)..\external\horizon\</HorizonRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fighter2D.csproj" />
    <ProjectReference Include="$(HorizonRoot)Horizon\Horizon.csproj" />
    <ProjectReference Include="$(HorizonRoot)Horizon.HIDL\Horizon.HIDL.csproj" />
  </ItemGroup>

</Project>
