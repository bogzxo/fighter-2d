<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Platforms>AnyCPU;x64</Platforms>
    <StartupObject>Fighter2D.App.Program</StartupObject>
  </PropertyGroup>

  <!--
    Publishing: dotnet publish -c Release -r win-x64 -p:Platform=x64
    That makes one native Fighter2D.exe (trimmed, no .NET needed on the machine it is run on) next to the Assets
    and shaders it loads, which is the folder to hand out.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    What is found by looking for it while the game runs rather than by being called, which trimming can't see and
    would throw out: DotTiled finds the classes a map is read into that way.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="DotTiled" />
  </ItemGroup>

  <!--
    The native compiler asks Visual Studio where its linker is (vcvarsall.bat), and newer Visual Studios run
    vswhere.exe for that without saying where it is: it is only found if its folder is on the PATH, which it isn't
    outside of a developer prompt. What vcvarsall then complains about ends up in front of the name of the linker
    and the publish fails with "'vswhere.exe' is not recognized". So the folder is put on the PATH of the build
    before any of that happens.
  -->
  <UsingTask TaskName="AddToPath" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Directory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string path = System.Environment.GetEnvironmentVariable("PATH") ?? "";
        if (System.IO.Directory.Exists(Directory) && path.IndexOf(Directory, System.StringComparison.OrdinalIgnoreCase) < 0)
            System.Environment.SetEnvironmentVariable("PATH", Directory + ";" + path);
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    A published game is its exe and its Assets folder, nothing else. Everything else it needs as a file (the
    native libraries of the packages, the shaders and fonts the engine projects bring) is packed into the exe
    here and unpacked next to it the first time it runs, see Content/PackedFiles.cs.
  -->
  <Target Name="PackEngineFiles" BeforeTargets="PrepareResources" DependsOnTargets="ResolvePackageAssets;GetCopyToOutputDirectoryItems" Condition="'$(Configuration)' == 'Release' and '$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <!-- Not what only a build needs to know about itself (which with some settings includes a launcher of the game
           that isn't there yet, Fighter2D.exe on Windows and plain Fighter2D on Linux), and not the odd test file a
           project leaves lying about -->
      <_PackedFile Include="@(AllItemsFullPathWithTargetPath)" Condition="!$([System.String]::Copy('%(TargetPath)').StartsWith('Assets')) and '%(Extension)' != '.json' and '%(Extension)' != '.pdb' and '%(Extension)' != '.exe' and '%(TargetPath)' != '$(AssemblyName)' and '%(Filename)%(Extension)' != 'test.hor'" />
      <_PackedFile Include="@(NativeCopyLocalItems)" TargetPath="%(NativeCopyLocalItems.DestinationSubPath)" />

      <EmbeddedResource Include="@(_PackedFile)" LogicalName="packed/$([System.String]::Copy('%(_PackedFile.TargetPath)').Replace('\', '/'))" Type="Non-Resx" WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="PublishOnlyAssets" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' == 'Release' and '$(PublishAot)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="!$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('Assets'))" />
    </ItemGroup>
  </Target>

  <Target Name="FindVisualStudioLocator" BeforeTargets="SetupOSSpecificProps" Condition="'$(OS)' == 'Windows_NT' and '$(PublishAot)' == 'true'">
    <AddToPath Directory="$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer" />
  </Target>

  <ItemGroup>
    <!-- Everything under Assets ships next to the exe as it is, Art is the source material and stays home -->
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RiptideNetworking.Riptide" Version="2.2.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\horizon\Horizon\Horizon.csproj" />
    <ProjectReference Include="..\horizon\Horizon.HIDL\Horizon.HIDL.csproj" />
  </ItemGroup>

</Project>
