// content_transfer, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.

compositor.design({ size: vec(1600, 900), fit: "contain" });

let box = compositor.stack({
    pos: vec(0, 48),
    anchor: "bottom",
    pivot: "bottom",
    padding: vec(36, 24, 36, 24),
    intro: "slide",
    intro_time: 0.3,
    intro_offset: vec(0, -220),
    background: "panel",
    spacing: 12
});

let title = compositor.label({
    parent: box,
    text: "@transfer.getting",
    text_scale: 0.4
});

let bar = compositor.progress_bar({
    parent: box,
    scale: vec(4, 2),
    fill: "horizontal",
    text_scale: 0.6
});

let detail = compositor.readout({
    parent: box,
    text: "0.0 of 0.0 MB",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1),
    align: "center"
});
