// pause_menu, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
#define layout

compositor.design({ size: vec(1600, 900), fit: "contain" });

let columns = compositor.stack({
    pos: vec(1.5686035, 14),
    layer: "menu",
    spacing: 22,
    direction: "horizontal"
});

let menu = compositor.stack({
    parent: columns,
    layer: "menu",
    anchor: "top",
    pivot: "top",
    fill: "vertical",
    padding: vec(44, 34, 44, 34),
    intro: "pop",
    intro_time: 0.25,
    background: "frame",
    stagger: 0.05,
    spacing: 14
});

let title = compositor.label({
    parent: menu,
    text: "@pause.paused",
    text_scale: 0.8
});

let subtitle = compositor.label({
    parent: menu,
    text: "@pause.on_hold",
    text_scale: 0.24,
    color: vec(0.58, 0.6, 0.66, 1)
});

let menu_rule = compositor.divider({
    parent: menu,
    fill: "horizontal",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let btn_resume = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    label: "@pause.carry_on"
});

let btn_rematch = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    label: "@pause.start_over"
});

let btn_options = compositor.button({
    parent: menu,
    pos: vec(16, -16),
    size: vec(360, 0),
    intro: "pop",
    label: "@pause.options",
    style: "button_flat"
});

let btn_quit = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    label: "@pause.main_menu",
    style: "button_flat"
});

let side = compositor.stack({
    parent: columns,
    layer: "menu",
    anchor: "top",
    pivot: "top",
    fill: "vertical",
    padding: vec(36, 30, 36, 30),
    intro: "pop",
    intro_time: 0.25,
    background: "panel",
    stagger: 0.05,
    spacing: 12
});

let tools_title = compositor.label({
    parent: side,
    intro: "pop",
    text: "@pause.host_tools",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1)
});

let btn_reload = compositor.button({
    parent: side,
    size: vec(400, 0),
    intro: "pop",
    label: "@pause.reload",
    lbl_scale: 0.3,
    style: "button_flat"
});

let btn_hitboxes = compositor.button({
    parent: side,
    size: vec(400, 0),
    intro: "pop",
    label: "@pause.hitboxes_off",
    lbl_scale: 0.3,
    style: "button_flat"
});

// Over the frame bars of the fight rather than on them, between them and the panels
// The line of what the buttons do, on a strip of its own so it reads over anything
let hint_bar = compositor.stack({
    pos: vec(0, 160),
    layer: "menu",
    anchor: "bottom",
    pivot: "bottom",
    padding: vec(24, 8, 24, 8),
    background: "panel"
});

let hint = compositor.label({
    parent: hint_bar,
    size: vec(1500, 34),
    text: "",
    text_scale: 0.34,
    color: vec(0.86, 0.88, 0.94, 1)
});

let count = compositor.readout({
    pos: vec(0, 110),
    layer: "countdown",
    text: "3",
    text_scale: 2.4,
    align: "center"
});

let waiting = compositor.stack({
    layer: "waiting",
    padding: vec(44, 36, 44, 36),
    background: "panel",
    spacing: 14
});

let waiting_title = compositor.label({
    parent: waiting,
    text: "@pause.paused",
    text_scale: 0.8
});

let waiting_detail = compositor.label({
    parent: waiting,
    text: "@pause.other_paused",
    text_scale: 0.28,
    color: vec(0.58, 0.6, 0.66, 1)
});
