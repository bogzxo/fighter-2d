// pause_menu, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.

compositor.design({ size: vec(1600, 900), fit: "contain" });

let columns = compositor.stack({
    pos: vec(1.5686035, 14),
    layer: "menu",
    spacing: 22,
    direction: "horizontal"
});

let menu = compositor.stack({
    parent: columns,
    layer: "menu",
    anchor: "top",
    pivot: "top",
    fill: "vertical",
    padding: vec(44, 34, 44, 34),
    intro: "pop",
    intro_time: 0.25,
    background: "panel",
    stagger: 0.05,
    spacing: 14
});

let title = compositor.label({
    parent: menu,
    text: "@pause.paused",
    text_scale: 0.8
});

let subtitle = compositor.label({
    parent: menu,
    text: "@pause.on_hold",
    text_scale: 0.24,
    color: vec(0.58, 0.6, 0.66, 1)
});

let menu_rule = compositor.divider({
    parent: menu,
    fill: "horizontal",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let btn_resume = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    label: "@pause.carry_on"
});

let btn_rematch = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    label: "@pause.start_over"
});

let btn_options = compositor.button({
    parent: menu,
    pos: vec(16, -16),
    size: vec(360, 0),
    intro: "pop",
    label: "@pause.options",
    style: "button_flat"
});

let btn_quit = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    label: "@pause.main_menu",
    style: "button_flat"
});

let side = compositor.stack({
    parent: columns,
    layer: "menu",
    anchor: "top",
    pivot: "top",
    fill: "vertical",
    padding: vec(36, 30, 36, 30),
    intro: "pop",
    intro_time: 0.25,
    background: "panel",
    stagger: 0.05,
    spacing: 12
});

let tools_title = compositor.label({
    parent: side,
    intro: "pop",
    text: "@pause.host_tools",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1)
});

let btn_reload = compositor.button({
    parent: side,
    size: vec(400, 0),
    intro: "pop",
    label: "@pause.reload",
    lbl_scale: 0.3,
    style: "button_flat"
});

let btn_hitboxes = compositor.button({
    parent: side,
    size: vec(400, 0),
    intro: "pop",
    label: "@pause.hitboxes_off",
    lbl_scale: 0.3,
    style: "button_flat"
});

let training_rule = compositor.divider({
    parent: side,
    layer: "training",
    fill: "horizontal",
    intro: "pop",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let training_title = compositor.label({
    parent: side,
    layer: "training",
    intro: "pop",
    text: "@pause.training",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1)
});

let dummy_row = compositor.stack({
    parent: side,
    layer: "training",
    intro: "pop",
    spacing: 16,
    direction: "horizontal"
});

let dummy_title = compositor.label({
    parent: dummy_row,
    size: vec(130, 0),
    text: "@pause.dummy",
    text_scale: 0.28,
    align: "left"
});

let dummy = compositor.selector({
    parent: dummy_row,
    size: vec(254, 44),
    text_scale: 0.26
});

let opponent_row = compositor.stack({
    parent: side,
    layer: "training",
    intro: "pop",
    spacing: 16,
    direction: "horizontal"
});

let opponent_title = compositor.label({
    parent: opponent_row,
    size: vec(130, 0),
    text: "@pause.opponent",
    text_scale: 0.28,
    align: "left"
});

let opponent = compositor.selector({
    parent: opponent_row,
    size: vec(254, 44),
    text_scale: 0.26
});

let refill_row = compositor.stack({
    parent: side,
    layer: "training",
    intro: "pop",
    spacing: 16,
    direction: "horizontal"
});

let refill_title = compositor.label({
    parent: refill_row,
    size: vec(130, 0),
    text: "@pause.refill",
    text_scale: 0.28,
    align: "left"
});

let refill = compositor.selector({
    parent: refill_row,
    size: vec(254, 44),
    text_scale: 0.26
});

let btn_reset = compositor.button({
    parent: side,
    size: vec(400, 0),
    layer: "training",
    intro: "pop",
    label: "@pause.reset_positions",
    lbl_scale: 0.3,
    style: "button_flat"
});

let hint = compositor.label({
    pos: vec(0, 22),
    size: vec(1500, 30),
    layer: "menu",
    anchor: "bottom",
    pivot: "bottom",
    text: "@pause.hint",
    text_scale: 0.25,
    color: vec(0.86, 0.88, 0.92, 1)
});

let count = compositor.readout({
    pos: vec(0, 110),
    layer: "countdown",
    text: "3",
    text_scale: 2.4,
    align: "center"
});

let waiting = compositor.stack({
    layer: "waiting",
    padding: vec(44, 36, 44, 36),
    background: "panel",
    spacing: 14
});

let waiting_title = compositor.label({
    parent: waiting,
    text: "@pause.paused",
    text_scale: 0.8
});

let waiting_detail = compositor.label({
    parent: waiting,
    text: "@pause.other_paused",
    text_scale: 0.28,
    color: vec(0.58, 0.6, 0.66, 1)
});
