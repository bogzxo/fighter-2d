// Where the players pick their gamepads, and the lobby of an online fight (GamepadSelectorScene.cs).
// The game makes one card per player out of player_card.hor and writes the title and the hint itself.

// Made for 16:9 and kept 16:9, smack in the middle of whatever screen it ends up on
compositor.design({ size: vec(1600, 900), fit: "contain" });

let panel = compositor.stack({
    background: "panel",
    padding: vec(40, 34),
    spacing: 24,
    intro: "pop",
    intro_time: 0.4
});

let title = compositor.label({ parent: panel, text: "Pick your gamepads", text_scale: 0.6 });
let cards = compositor.stack({
    parent: panel,
    direction: "horizontal",
    spacing: 24,
    stagger: 0.12,
    template: "player_card.hor",
    preview_count: 2
});
let hint = compositor.label({
    parent: panel,
    size: vec(0, 24),
    text: "[icon:pad_b] back",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});
let btn_back = compositor.button({ parent: panel, label: "Back", size: vec(180, 0) });
