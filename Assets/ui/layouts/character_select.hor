// Where everybody picks who they play (CharacterSelectScene.cs): whoever is being looked at on the left,
// everybody there is to pick from on the right. The game makes the cells of the grid out of character_cell.hor,
// as many rows of them as the grid has columns, and fills in the preview and its bars.

// Made for 16:9 and kept 16:9, smack in the middle of whatever screen it ends up on
compositor.design({ size: vec(1600, 900), fit: "contain" });

let panel = compositor.stack({
    background: "panel",
    padding: vec(40, 34),
    spacing: 22,
    intro: "pop",
    intro_time: 0.4
});

let title = compositor.label({ parent: panel, text: "Choose your fighter", text_scale: 0.6 });
let rule = compositor.divider({ parent: panel, fill: "horizontal", color: vec(0.58, 0.6, 0.66, 0.35) });
let columns = compositor.stack({ parent: panel, direction: "horizontal", spacing: 28 });

let preview_box = compositor.stack({ parent: columns, background: "button_flat", padding: vec(26, 24), spacing: 12 });
let preview = compositor.image({ parent: preview_box, size: vec(288, 288) });
let preview_name = compositor.label({ parent: preview_box, size: vec(330, 34), text: "Fighter", text_scale: 0.42 });

let speed_row = compositor.stack({ parent: preview_box, direction: "horizontal", spacing: 12 });
let speed_title = compositor.label({
    parent: speed_row,
    size: vec(140, 0),
    text: "Speed",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1),
    align: "left"
});
let speed = compositor.progress_bar({ parent: speed_row, size: vec(178, 24), show_text: false });

let health_row = compositor.stack({ parent: preview_box, direction: "horizontal", spacing: 12 });
let health_title = compositor.label({
    parent: health_row,
    size: vec(140, 0),
    text: "Health",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1),
    align: "left"
});
let health = compositor.progress_bar({ parent: health_row, size: vec(178, 24), show_text: false });

let bulk_row = compositor.stack({ parent: preview_box, direction: "horizontal", spacing: 12 });
let bulk_title = compositor.label({
    parent: bulk_row,
    size: vec(140, 0),
    text: "Bulkiness",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1),
    align: "left"
});
let bulk = compositor.progress_bar({ parent: bulk_row, size: vec(178, 24), show_text: false });

let complexity_row = compositor.stack({ parent: preview_box, direction: "horizontal", spacing: 12 });
let complexity_title = compositor.label({
    parent: complexity_row,
    size: vec(140, 0),
    text: "Complexity",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1),
    align: "left"
});
let complexity = compositor.progress_bar({ parent: complexity_row, size: vec(178, 24), show_text: false });

let grid = compositor.grid({
    parent: columns,
    anchor: "top",
    columns: 3,
    spacing: 10,
    stagger: 0.04,
    template: "character_cell.hor",
    preview_count: 9
});

let hint = compositor.label({
    parent: panel,
    text: "[icon:dpad] choose    [icon:pad_a] pick    [icon:pad_b] back",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});
