// bindings, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.

compositor.design({ size: vec(1600, 900), fit: "contain" });

let panel = compositor.stack({
    pos: vec(0, 14),
    padding: vec(44, 30, 44, 30),
    intro: "pop",
    intro_time: 0.3,
    background: "panel",
    spacing: 16
});

let title = compositor.label({
    parent: panel,
    text: "Bindings of player 1",
    text_scale: 0.6
});

let gamepad_name = compositor.label({
    parent: panel,
    text: "Gamepad",
    text_scale: 0.26,
    color: vec(0, 0.86, 1, 1)
});

let rule = compositor.divider({
    parent: panel,
    fill: "horizontal",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let columns = compositor.stack({
    parent: panel,
    spacing: 44,
    direction: "horizontal"
});

let column_1 = compositor.stack({
    parent: columns,
    anchor: "top",
    pivot: "top",
    template: "binding_row.hor",
    preview_count: 8,
    stagger: 0.03,
    spacing: 6
});

let column_2 = compositor.stack({
    parent: columns,
    anchor: "top",
    pivot: "top",
    template: "binding_row.hor",
    preview_count: 8,
    stagger: 0.03,
    spacing: 6
});

let rule_2 = compositor.divider({
    parent: panel,
    fill: "horizontal",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let actions = compositor.stack({
    parent: panel,
    spacing: 16,
    direction: "horizontal"
});

let btn_defaults = compositor.button({
    parent: actions,
    pos: vec(0, 1.7632751),
    size: vec(330, 0),
    label: "@bindings.defaults",
    lbl_scale: 0.3,
    style: "button_flat"
});

let btn_done = compositor.button({
    parent: actions,
    size: vec(220, 0),
    label: "@bindings.done",
    lbl_scale: 0.3
});

let hint = compositor.label({
    pos: vec(0, 22),
    size: vec(1500, 30),
    anchor: "bottom",
    pivot: "bottom",
    text: "@bindings.choose",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});
