// main_menu, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
#define layout


compositor.design({ size: vec(1600, 900), fit: "contain" });

let menu = compositor.stack({
    pos: vec(90, -120),
    anchor: "left",
    pivot: "left",
    padding: vec(36, 28, 36, 28),
    intro: "slide",
    intro_time: 0.55,
    intro_delay: 0.2,
    intro_offset: vec(-520, 0),
    background: "panel",
    stagger: 0.1,
    spacing: 10
});

let btn_pvp = compositor.button({
    parent: menu,
    pos: vec(0, 1.1349335),
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.35,
    hover: "pulse",
    label: "@main_menu.pvp"
});

let btn_practice = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.35,
    hover: "pulse",
    label: "@main_menu.practice"
});

let btn_host = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.35,
    hover: "pulse",
    label: "@main_menu.host"
});

let btn_join = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.35,
    hover: "pulse",
    label: "@main_menu.join"
});

let btn_options = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.35,
    hover: "pulse",
    label: "@main_menu.options",
    style: "button_flat"
});

let btn_quit = compositor.button({
    parent: menu,
    size: vec(360, 0),
    intro: "pop",
    intro_delay: 0.35,
    hover: "pulse",
    label: "@main_menu.quit",
    style: "button_flat"
});

let rule = compositor.divider({
    parent: menu,
    fill: "horizontal",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let description = compositor.label({
    parent: menu,
    size: vec(360, 46),
    text: "@main_menu.about_pvp",
    text_scale: 0.24,
    color: vec(0.86, 0.88, 0.92, 1),
    wrap: true,
    align: "top"
});

let hint = compositor.label({
    parent: menu,
    size: vec(0, 30),
    text: "@main_menu.hint",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});

let version = compositor.label({
    parent: menu,
    text: "version",
    text_scale: 0.2,
    color: vec(0.58, 0.6, 0.66, 1)
});

let logo = compositor.image({
    pos: vec(12, 0),
    size: vec(500, 240),
    anchor: "top_left",
    pivot: "top_left",
    intro: "pop",
    intro_time: 0.7,
    intro_delay: 0.15,
    file: "Assets/ui/logo.png"
});
