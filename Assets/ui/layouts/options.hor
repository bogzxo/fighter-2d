let about = compositor.stack({
    parent: body,
    pos: vec(-1.5686035, 0),
    anchor: "top",
    pivot: "top",
    fill: "both",
    padding: vec(26, 22, 26, 22),
    intro: "slide",
    intro_time: 0.2,
    intro_delay: 0.2,
    intro_offset: vec(150, 0),
    background: "panel",
    spacing: 14
});

let about_title = compositor.label({
    parent: about,
    size: vec(330, 34),
    text: "@options.display",
    text_scale: 0.36
});

let about_rule = compositor.divider({
    parent: about,
    fill: "horizontal",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let description = compositor.label({
    parent: about,
    size: vec(330, 330),
    fill: "vertical",
    text_scale: 0.25,
    color: vec(0.86, 0.88, 0.92, 1),
    wrap: true,
    markdown: true,
    align: "top_left"
});

let rule = compositor.divider({
    parent: panel,
    fill: "horizontal",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let actions = compositor.stack({
    parent: panel,
    spacing: 16,
    direction: "horizontal"
});

let btn_bindings = compositor.button({
    parent: actions,
    size: vec(330, 0),
    label: "@options.bindings",
    lbl_scale: 0.3
});

let btn_back = compositor.button({
    parent: actions,
    size: vec(180, 0),
    label: "@options.back",
    lbl_scale: 0.3,
    style: "button_flat"
});

let hint = compositor.label({
    pos: vec(0, 22),
    size: vec(1500, 30),
    anchor: "bottom",
    pivot: "bottom",
    text: "@options.hint",
    text_scale: 0.5,
    color: vec(1, 1, 1, 1)
});
