// options, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.

compositor.design({ size: vec(1600, 900), fit: "contain" });

let panel = compositor.stack({
    pos: vec(0, 14),
    padding: vec(44, 30, 44, 30),
    intro: "pop",
    intro_time: 0.3,
    background: "panel",
    spacing: 16
});

let title = compositor.label({
    parent: panel,
    text: "@options.title",
    text_scale: 0.6
});

let body = compositor.stack({
    parent: panel,
    spacing: 30,
    direction: "horizontal"
});

let left = compositor.stack({
    parent: body,
    anchor: "top",
    pivot: "top",
    spacing: 14
});

let tabs = compositor.tabs({
    parent: left,
    intro: "slide",
    intro_time: 0.2,
    intro_delay: 0.2,
    intro_offset: vec(-150, 0),
    tabs: [
    "@options.tab_display",
    "@options.tab_graphics",
    "@options.tab_look",
    "@options.tab_fight"
],
    text_scale: 0.36,
    spacing: 56,
    prev_hint: "[icon:pad_lb]",
    next_hint: "[icon:pad_rb]",
    accent: vec(1, 1, 1, 1),
    color: vec(0.58, 0.6, 0.66, 1)
});

let display_rows = compositor.stack({
    parent: tabs,
    intro: "slide",
    intro_time: 0.25,
    intro_offset: vec(0, -24),
    spacing: 6
});

let display_row = compositor.stack({
    parent: display_rows,
    padding: vec(14, 5, 14, 5),
    hover: "nudge",
    radius: 6,
    spacing: 24,
    direction: "horizontal"
});

let display_title = compositor.label({
    parent: display_row,
    size: vec(300, 0),
    text: "@options.display",
    text_scale: 0.32,
    align: "left"
});

let display = compositor.selector({
    parent: display_row,
    size: vec(380, 48),
    text_scale: 0.28
});

let resolution_row = compositor.stack({
    parent: display_rows,
    padding: vec(14, 5, 14, 5),
    intro_delay: 0.1,
    hover: "nudge",
    radius: 6,
    spacing: 24,
    direction: "horizontal"
});

let resolution_title = compositor.label({
    parent: resolution_row,
    size: vec(300, 0),
    text: "@options.resolution",
    text_scale: 0.32,
    align: "left"
});

let resolution = compositor.selector({
    parent: resolution_row,
    size: vec(380, 48),
    text_scale: 0.28
});

