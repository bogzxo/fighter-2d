// fight_setup, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.

compositor.design({ size: vec(1600, 900), fit: "contain" });

let left = compositor.stack({
    pos: vec(36, 6),
    anchor: "left",
    pivot: "left",
    intro: "slide",
    intro_time: 0.4,
    intro_offset: vec(-460, 0),
    template: "fighter_panel.hor",
    preview_count: 1
});

let right = compositor.stack({
    pos: vec(-36, 6),
    anchor: "right",
    pivot: "right",
    intro: "slide",
    intro_time: 0.4,
    intro_offset: vec(460, 0),
    template: "fighter_panel.hor",
    preview_count: 1
});

let middle = compositor.stack({
    pos: vec(0, 6),
    padding: vec(30, 24, 30, 24),
    intro: "pop",
    background: "panel",
    spacing: 12
});

let title = compositor.label({
    parent: middle,
    text: "Versus",
    text_scale: 0.56
});

let subtitle = compositor.label({
    parent: middle,
    size: vec(520, 22),
    text: "@setup.pick_fighters",
    text_scale: 0.24,
    color: vec(0.58, 0.6, 0.66, 1)
});

let grid = compositor.grid({
    parent: middle,
    template: "fighter_cell.hor",
    preview_count: 6,
    stagger: 0.03,
    columns: 3,
    spacing: 8
});

let rule = compositor.divider({
    parent: middle,
    fill: "horizontal",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let rows = compositor.stack({ parent: middle, spacing: 6 });

let map_row = compositor.stack({
    parent: rows,
    padding: vec(10, 3, 10, 3),
    radius: 6,
    spacing: 16,
    direction: "horizontal"
});

let map_title = compositor.label({
    parent: map_row,
    size: vec(150, 0),
    text: "@setup.map",
    text_scale: 0.3,
    align: "left"
});

let map = compositor.selector({
    parent: map_row,
    size: vec(340, 44),
    text_scale: 0.28
});

let rounds_row = compositor.stack({
    parent: rows,
    padding: vec(10, 3, 10, 3),
    radius: 6,
    spacing: 16,
    direction: "horizontal"
});

let rounds_title = compositor.label({
    parent: rounds_row,
    size: vec(150, 0),
    text: "@setup.rounds",
    text_scale: 0.3,
    align: "left"
});

let rounds = compositor.selector({
    parent: rounds_row,
    size: vec(340, 44),
    text_scale: 0.28
});

let time_row = compositor.stack({
    parent: rows,
    padding: vec(10, 3, 10, 3),
    radius: 6,
    spacing: 16,
    direction: "horizontal"
});

let time_title = compositor.label({
    parent: time_row,
    size: vec(150, 0),
    text: "@setup.round_time",
    text_scale: 0.3,
    align: "left"
});

let time = compositor.selector({
    parent: time_row,
    size: vec(340, 44),
    text_scale: 0.28
});

let weather_row = compositor.stack({
    parent: rows,
    padding: vec(10, 3, 10, 3),
    radius: 6,
    spacing: 16,
    direction: "horizontal"
});

let weather_title = compositor.label({
    parent: weather_row,
    size: vec(150, 0),
    text: "@setup.weather",
    text_scale: 0.3,
    align: "left"
});

let weather = compositor.selector({
    parent: weather_row,
    size: vec(340, 44),
    text_scale: 0.28
});

let btn_fight = compositor.button({
    parent: middle,
    size: vec(260, 0),
    intro: "pop",
    intro_delay: 0.2,
    label: "@setup.fight"
});

let hint = compositor.label({
    pos: vec(0, 22),
    size: vec(1500, 30),
    anchor: "bottom",
    pivot: "bottom",
    text: "@setup.hint_pick",
    text_scale: 0.25,
    color: vec(0.58, 0.6, 0.66, 1)
});

let btn_back = compositor.button({
    pos: vec(36, -22),
    size: vec(130, 0),
    anchor: "top_left",
    pivot: "top_left",
    label: "@setup.back",
    lbl_scale: 0.26,
    style: "button_flat"
});
