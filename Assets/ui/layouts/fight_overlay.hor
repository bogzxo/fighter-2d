// fight_overlay, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
#define layout

compositor.design({ size: vec(1600, 900), fit: "stretch" });

let player1_health = compositor.progress_bar({
    pos: vec(40, -22),
    size: vec(580, 48),
    layer: "hud",
    anchor: "top_left",
    pivot: "top_left",
    intro: "slide",
    intro_delay: 0.4,
    intro_offset: vec(-720, 0),
    ghost: 1,
    show_text: false
});

let player2_health = compositor.progress_bar({
    pos: vec(-40, -22),
    size: vec(580, 48),
    layer: "hud",
    anchor: "top_right",
    pivot: "top_right",
    intro: "slide",
    intro_delay: 0.4,
    intro_offset: vec(720, 0),
    ghost: 1,
    reverse: true,
    show_text: false
});

let player1_plate = compositor.stack({
    pos: vec(52, -76),
    layer: "hud",
    anchor: "top_left",
    pivot: "top_left",
    intro: "slide",
    intro_delay: 0.5,
    intro_offset: vec(-640, 0),
    spacing: 22,
    direction: "horizontal"
});

let player1_name = compositor.label({
    parent: player1_plate,
    text: "PLAYER ONE",
    text_scale: 0.36
});

let player1_rounds = compositor.label({
    parent: player1_plate,
    text_scale: 0.34,
    color: vec(1, 0.82, 0.25, 1)
});

let player2_plate = compositor.stack({
    pos: vec(-52, -76),
    layer: "hud",
    anchor: "top_right",
    pivot: "top_right",
    intro: "slide",
    intro_delay: 0.5,
    intro_offset: vec(640, 0),
    spacing: 22,
    direction: "horizontal"
});

let player2_rounds = compositor.label({
    parent: player2_plate,
    text_scale: 0.34,
    color: vec(1, 0.82, 0.25, 1)
});

let player2_name = compositor.label({
    parent: player2_plate,
    text: "PLAYER TWO",
    text_scale: 0.36
});

let timer_background = compositor.panel({
    pos: vec(0, -22),
    size: vec(260, 100),
    layer: "hud",
    anchor: "top",
    pivot: "top",
    padding: vec(30, 18, 30, 17.5),
    intro: "slide",
    intro_delay: 0.35,
    intro_offset: vec(0, 148),
    background: "button_selected",
    color: vec(1, 1, 1, 0.604)
});

let timer_label = compositor.readout({
    parent: timer_background,
    pos: vec(0, 1),
    intro: "pop",
    intro_delay: 0.3,
    text: "99",
    text_scale: 1.25,
    align: "center"
});

let round_label = compositor.label({
    pos: vec(0, -122),
    layer: "hud",
    anchor: "top",
    pivot: "top",
    intro: "slide",
    intro_delay: 0.7,
    intro_offset: vec(0, 27.6),
    text: "ROUND 1",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1)
});

let player1_meter = compositor.progress_bar({
    pos: vec(40, 34),
    size: vec(440, 22),
    layer: "hud",
    anchor: "bottom_left",
    pivot: "bottom_left",
    intro: "slide",
    intro_delay: 0.55,
    intro_offset: vec(-520, 0),
    progress: 0,
    fill_color: vec(1, 0.82, 0.25, 1),
    segments: 4,
    show_text: false
});

let player1_meter_label = compositor.label({
    pos: vec(48, 62),
    layer: "hud",
    anchor: "bottom_left",
    pivot: "bottom_left",
    text: "@fight.meter",
    text_scale: 0.22,
