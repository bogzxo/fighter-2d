    size: vec(420, 56),
    layer: "hud",
    anchor: "top_left",
    pivot: "top_left",
    text_scale: 0.6,
    align: "left"
});

let player1_combo = compositor.readout({
    pos: vec(330, -206),
    size: vec(480, 64),
    layer: "hud",
    anchor: "top_left",
    pivot: "top_left",
    text_scale: 0.8
});

let player1_frames = compositor.label({
    pos: vec(330, -272),
    size: vec(420, 34),
    layer: "hud",
    anchor: "top_left",
    pivot: "top_left",
    text_scale: 0.3,
