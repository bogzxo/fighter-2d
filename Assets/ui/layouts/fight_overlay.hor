});

let player2_callout = compositor.label({
    pos: vec(-330, -150),
    size: vec(420, 56),
    layer: "hud",
    anchor: "top_right",
    pivot: "top_right",
    text_scale: 0.6,
    align: "right"
});

let player2_combo = compositor.readout({
    pos: vec(-330, -206),
    size: vec(480, 64),
    layer: "hud",
    anchor: "top_right",
    pivot: "top_right",
    text_scale: 0.8,
    align: "right"
});

let player2_frames = compositor.label({
    pos: vec(-330, -272),
    size: vec(420, 34),
    layer: "hud",
    anchor: "top_right",
    pivot: "top_right",
    text_scale: 0.3,
    align: "right"
});

let frame_bars = compositor.stack({
    pos: vec(0, 22),
    layer: "hud",
    anchor: "bottom",
    pivot: "bottom",
    intro: "slide",
    intro_delay: 0.6,
    intro_offset: vec(0, -160),
    spacing: 4
});

let player1_move_row = compositor.stack({
    parent: frame_bars,
    spacing: 0,
    direction: "horizontal"
});

let player1_move = compositor.label({
    parent: player1_move_row,
    size: vec(200, 20),
    text: "P1",
    text_scale: 0.2,
    align: "left"
});

let player1_move_data = compositor.readout({
    parent: player1_move_row,
    size: vec(420, 20),
    text_scale: 0.2,
    color: vec(0.74, 0.78, 0.86, 1),
    align: "right"
});

let player1_move_bar = compositor.segments({
    parent: frame_bars,
    pos: vec(-1.5686646, 0),
    size: vec(620, 12),
    ahead_opacity: 0.3
});

let frame_bars_gap = compositor.spacer({ parent: frame_bars, size: vec(620, 4) });

let player2_move_row = compositor.stack({
    parent: frame_bars,
    spacing: 0,
    direction: "horizontal"
});

let player2_move = compositor.label({
    parent: player2_move_row,
    size: vec(200, 20),
    text: "P2",
    text_scale: 0.2,
    align: "left"
});

let player2_move_data = compositor.readout({
    parent: player2_move_row,
    size: vec(420, 20),
    text_scale: 0.2,
    color: vec(0.74, 0.78, 0.86, 1),
    align: "right"
});

let player2_move_bar = compositor.segments({
    parent: frame_bars,
    size: vec(620, 12),
    ahead_opacity: 0.3
});

let banner_stripe = compositor.stack({
    layer: "banner",
    padding: vec(100, 32, 100, 32),
    color: vec(0.1, 0.12, 0.17, 0.9),
    radius: 16
});

let banner = compositor.label({
    parent: banner_stripe,
    pos: vec(0, -2.6),
    layer: "banner",
    text: "ROUND 1",
    text_scale: 1.7
});

let banner_detail = compositor.label({
    parent: banner_stripe,
    pos: vec(0, -2.6),
    layer: "banner",
    text: "takes the round",
    text_scale: 0.4
});

let flash = compositor.panel({
    layer: "flash",
    fill: "both",
    color: vec(1, 1, 1, 1)
});

let versus = compositor.stack({
    pos: vec(0.51278687, 0),
    layer: "versus",
    padding: vec(56, 40, 56, 40),
    intro: "pop",
    background: "bar_frame",
    color: vec(1, 1, 1, 0.5),
    spacing: 44,
    direction: "horizontal"
});

let versus_p1_box = compositor.stack({
    parent: versus,
    padding: vec(22, 20, 22, 20),
    intro: "slide",
    intro_delay: 0.2,
    intro_offset: vec(-150, 0),
    background: "button_flat",
    spacing: 12
});

let versus_p1 = compositor.image({ parent: versus_p1_box, size: vec(256, 256) });

let versus_p1_name = compositor.label({
    parent: versus_p1_box,
    size: vec(280, 34),
    text: "Fighter",
    text_scale: 0.42
});

let versus_middle = compositor.stack({ parent: versus, spacing: 14 });

let versus_title = compositor.label({
    parent: versus_middle,
    pos: vec(45.490143, -98.82355),
    intro: "pop",
    intro_delay: 0.3,
    text: "@fight.versus",
    text_scale: 1.6
});

let versus_rules = compositor.label({
    parent: versus_middle,
    intro: "pop",
    intro_delay: 0.3,
    text: "First to 3",
    text_scale: 0.28,
    color: vec(0.58, 0.6, 0.66, 1)
});

let versus_p2_box = compositor.stack({
    parent: versus,
    padding: vec(22, 20, 22, 20),
    intro: "slide",
    intro_delay: 0.2,
    intro_offset: vec(150, 0),
    background: "button_flat",
    spacing: 12
});

let versus_p2 = compositor.image({ parent: versus_p2_box, size: vec(256, 256) });

let versus_p2_name = compositor.label({
    parent: versus_p2_box,
    size: vec(280, 34),
    text: "Fighter",
    text_scale: 0.42
});

// The result card, on a layer of its own that the match comes up with once it is decided (HUD/ResultCard.cs). Who won,
// the score and how every round went, what both of them did, and the three ways on
let result = compositor.stack({
    layer: "result",
    padding: vec(52, 36, 52, 36),
    intro: "pop",
    intro_time: 0.25,
    background: "panel",
    stagger: 0.03,
    spacing: 12
});

let result_title = compositor.label({
    parent: result,
    text: "",
    text_scale: 0.9
});

let result_score = compositor.label({
    parent: result,
    text: "",
    text_scale: 0.55
});

let result_rounds = compositor.label({
    parent: result,
    size: vec(760, 0),
    text: "",
    text_scale: 0.24,
    color: vec(0.58, 0.6, 0.66, 1)
});

let result_rule = compositor.divider({
    parent: result,
    fill: "horizontal",
    color: vec(0.58, 0.6, 0.66, 0.35)
});

let result_names_row = compositor.stack({
