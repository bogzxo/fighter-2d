// One cell of the roster on the fight setup screen, made once per cell by fight_setup.hor.
// With a character in it the game shows the portrait and the name, without one the question mark.

let box = compositor.button({
    style: "button_flat",
    size: vec(170, 146),
    intro: "pop",
    intro_time: 0.3,
    intro_delay: 0.15
});

let tags = compositor.label({ parent: box, anchor: "top", pos: vec(0, -10), text: "P1", text_scale: 0.22 });
let portrait = compositor.image({ parent: box, pos: vec(0, 2), size: vec(96, 96) });
let name = compositor.label({
    parent: box,
    anchor: "bottom",
    pos: vec(0, 12),
    text: "Fighter",
    text_scale: 0.19,
    color: vec(0.58, 0.6, 0.66, 1)
});
let empty = compositor.label({ parent: box, visible: false, text: "?", text_scale: 0.6, color: vec(0.58, 0.6, 0.66, 1) });
