// fighter_cell, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
#define layout

let box = compositor.button({
    size: vec(170, 146),
    intro: "slide",
    intro_time: 0.3,
    intro_delay: 0.15,
    intro_offset: vec(0, 31.5),
    style: "button_flat"
});

let tags = compositor.label({
    parent: box,
    pos: vec(0, -10),
    anchor: "top",
    pivot: "top",
    text: "P1",
    text_scale: 0.26
});

// The fighter from the chest up and big, the whole of them in a cell this size was too small to tell apart
let window = compositor.panel({
    parent: box,
    pos: vec(0, 4),
    size: vec(150, 92),
    clip: true
});

let portrait = compositor.image({
    parent: window,
    pos: vec(0, 112),
    size: vec(290, 290),
    anchor: "top",
    pivot: "top"
});

let name = compositor.label({
    parent: box,
    pos: vec(0, 12),
    anchor: "bottom",
    pivot: "bottom",
    text: "Fighter",
    text_scale: 0.24,
    color: vec(0.58, 0.6, 0.66, 1)
});

let empty = compositor.label({
    parent: box,
    visible: false,
    text: "?",
    text_scale: 0.6,
    color: vec(0.58, 0.6, 0.66, 1)
});
