// binding_row, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
#define layout

let row = compositor.stack({
    intro: "fade",
    intro_time: 0.25,
    intro_delay: 0.1,
    intro_offset: vec(-100, 0),
    spacing: 16,
    direction: "horizontal"
});

let action = compositor.label({
    parent: row,
    size: vec(210, 0),
    text: "Action",
    text_scale: 0.3,
    align: "left"
});

let binding = compositor.button({
    parent: row,
    size: vec(360, 46),
    label: "[icon:pad_a]",
    lbl_scale: 0.28,
    style: "button_flat"
});
