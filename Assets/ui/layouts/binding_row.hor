// One action on the bindings screen and the button that says what it is bound to, made once per action by bindings.hor.

let row = compositor.stack({
    direction: "horizontal",
    spacing: 16,
    intro: "slide",
    intro_time: 0.25,
    intro_delay: 0.1,
    intro_offset: vec(-100, 0)
});

let action = compositor.label({ parent: row, size: vec(210, 0), text: "Action", text_scale: 0.3, align: "left" });
let binding = compositor.button({
    parent: row,
    label: "[icon:pad_a]",
    style: "button_flat",
    size: vec(360, 46),
    lbl_scale: 0.28
});
