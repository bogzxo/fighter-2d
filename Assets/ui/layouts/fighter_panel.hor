// One side of the fight setup screen, made once a side by fight_setup.hor. Who is in that corner, drawn big with a few
// words about them running round their outline, what they are like in four bars, and under that whoever is going to
// play them (a gamepad, the dummy, somebody on another machine) and what they are up to. The two lines at the bottom
// are a fixed size so nothing jumps about as their texts change.
#define layout

let box = compositor.stack({
    background: "panel",
    padding: vec(26, 22),
    spacing: 9
});

let title = compositor.label({ parent: box, text: "Player 1", text_scale: 0.44 });
// The fighter stands off to one side and the blurb runs round them on the other (Menus/Widgets/FighterPanel.cs moves
// them over for the right hand corner, and gives the blurb their outline)
let portrait_box = compositor.panel({ parent: box, size: vec(320, 300) });
let portrait = compositor.image({ parent: portrait_box, pos: vec(-100, 0), size: vec(320, 300) });
// From their head down, the top of a frame is air over them and a blurb up there would never meet them
let blurb = compositor.label({
    parent: portrait_box,
    anchor: "bottom",
    pivot: "bottom",
    size: vec(320, 165),
    text: "",
    text_scale: 0.22,
    color: vec(0.74, 0.78, 0.86, 1),
    align: "top_left",
    wrap: true,
    wrap_around: portrait
});
let name = compositor.label({ parent: box, size: vec(330, 34), text: "Fighter", text_scale: 0.4 });

let speed_row = compositor.stack({ parent: box, direction: "horizontal", spacing: 12 });
let speed_title = compositor.label({ parent: speed_row, size: vec(132, 0), text: "@setup.speed", text_scale: 0.24, color: vec(0.58, 0.6, 0.66, 1), align: "left" });
let speed = compositor.progress_bar({ parent: speed_row, size: vec(186, 22), show_text: false });

let health_row = compositor.stack({ parent: box, direction: "horizontal", spacing: 12 });
let health_title = compositor.label({ parent: health_row, size: vec(132, 0), text: "@setup.health", text_scale: 0.24, color: vec(0.58, 0.6, 0.66, 1), align: "left" });
let health = compositor.progress_bar({ parent: health_row, size: vec(186, 22), show_text: false });

let bulk_row = compositor.stack({ parent: box, direction: "horizontal", spacing: 12 });
let bulk_title = compositor.label({ parent: bulk_row, size: vec(132, 0), text: "@setup.bulkiness", text_scale: 0.24, color: vec(0.58, 0.6, 0.66, 1), align: "left" });
let bulk = compositor.progress_bar({ parent: bulk_row, size: vec(186, 22), show_text: false });

let complexity_row = compositor.stack({ parent: box, direction: "horizontal", spacing: 12 });
let complexity_title = compositor.label({ parent: complexity_row, size: vec(132, 0), text: "@setup.complexity", text_scale: 0.24, color: vec(0.58, 0.6, 0.66, 1), align: "left" });
let complexity = compositor.progress_bar({ parent: complexity_row, size: vec(186, 22), show_text: false });

let rule = compositor.divider({ parent: box, fill: "horizontal", color: vec(0.58, 0.6, 0.66, 0.35) });

let status = compositor.label({ parent: box, size: vec(330, 30), text: "@setup.press_any_button", text_scale: 0.3 });
let detail = compositor.label({
    parent: box,
    size: vec(330, 24),
    text: "@setup.on_your_gamepad",
    text_scale: 0.23,
    color: vec(0.58, 0.6, 0.66, 1)
});
