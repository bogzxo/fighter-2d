// Where the address of a server is typed in (JoinServerScene.cs). The keys of the on-screen keyboard are put
// into keyboard_slot by the game, the status stays empty until there is something to say.
#define layout

// Made for 16:9 and kept 16:9, smack in the middle of whatever screen it ends up on
compositor.design({ size: vec(1600, 900), fit: "contain" });

let panel = compositor.stack({
    pos: vec(0, 14),
    background: "panel",
    padding: vec(48, 32),
    spacing: 16,
    intro: "pop",
    intro_time: 0.3
});

let title = compositor.label({ parent: panel, text: "@join.title", text_scale: 0.6 });
let subtitle = compositor.label({
    parent: panel,
    text: "@join.address_help",
    text_scale: 0.26,
    color: vec(0.58, 0.6, 0.66, 1)
});
let rule = compositor.divider({ parent: panel, fill: "horizontal", color: vec(0.58, 0.6, 0.66, 0.35) });
let address = compositor.textbox({ parent: panel, size: vec(460, 60), text: "127.0.0.1", max_length: 15, button: "@join.clear", button_side: "right", button_width: 96 });
let status = compositor.label({ parent: panel, size: vec(0, 22), text_scale: 0.25, color: vec(1, 0.45, 0.4, 1) });
let keyboard_slot = compositor.stack({ parent: panel });

// The line of what the buttons do, on a strip of its own so it reads over anything
let hint_bar = compositor.stack({
    pos: vec(0, 14),
    anchor: "bottom",
    pivot: "bottom",
    padding: vec(24, 8, 24, 8),
    background: "panel"
});

let hint = compositor.label({
    parent: hint_bar,
    size: vec(1500, 34),
    text: "",
    text_scale: 0.34,
    color: vec(0.86, 0.88, 0.94, 1)
});
