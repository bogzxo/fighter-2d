// Everything the two mannequins (The Male and The Female) have in common, which is nearly all of it. They were rendered off the
// same set of motions, so one move list does for both. What each of them does differently is in the_male_moves.hor and the_female_moves.hor,
// and what every key in here means is written down at the top of fighting_moves.hor.
//
// Every frame in here is a frame of the fight, 60 a second. Their art plays at the frame_rate of characters.hor, attacks at
// that and everything that is only stood around in at half of it (art_speed: 0.5), a little slower than it was made.
// The art going quicker or slower doesn't move a hit any more, the frames in here are what they are.
// The motions are long, most of an attack is somebody winding up and somebody putting their hands back. Nearly every phase says
// where in the animation it starts and how many frames of it it plays, which cuts both ends off.
//
//                 standing            crouching           in the air
//   A             high kick           low kick            jump kick
//   B             head kick           sweep               jump kick
//   X             jab                 body blow           -
//   Y             straight            uppercut            -
//   LeftBumper    hook
//   A + B         spin kick, a wheel kick that launches and knocks down. Costs a quarter of the meter
//   X + Y         flurry, jab, hook and straight in one go for three hits. Costs a quarter of the meter too
//
//   The low kick and the sweep are lows (block them crouching), the jump kick is an overhead (block it standing).
//   The uppercut is the launcher, the sweep and the spin kick knock down.
//   Down and a direction creeps along crouched, slowly. A hurtbox half as tall is worth being slow for.
//
// Whoever takes a round by K.O. walks over to the head of the loser and plays "victory" over it (see VictoryTaunt).

#define fight_move

let moves = {
    /* Getting around */

    idle: {
        stances: "standing",
        stance: "standing",
        phases: {
            stand: { animation: "idle", art_speed: 0.5, loop_while: "always", cancel: 0 }
        }
    },

    crouch: {
        input: "DPadDown",
        trigger: "held",
        priority: 60,
        stances: "standing",
        walk: 0,
        stance: "crouching",
        stance_after: "standing",
        phases: {
            duck: { animation: "crouch_down", start: 7, cancel: 0 },
            stay: { animation: "crouch_idle", art_speed: 0.5, loop_while: "held", cancel: 0 },
            rise: { animation: "crouch_to_stand", start: 5, frames: 10, cancel: 0 }
        }
    },

    // Crouching without ducking first, for somebody who is down there already (after a crouching attack, or creeping to a stop)
    crouch_hold: {
        input: "DPadDown",
        trigger: "held",
        priority: 61,
        stances: "crouching",
        walk: 0,
        stance: "crouching",
        stance_after: "standing",
        phases: {
            stay: { animation: "crouch_idle", art_speed: 0.5, loop_while: "held", cancel: 0 },
            rise: { animation: "crouch_to_stand", start: 5, frames: 10, cancel: 0 }
        }
    },

    crouch_walk: {
        input: ["DPadDown + DPadLeft", "DPadDown + DPadRight"],
        trigger: "held",
        priority: 55,
        stances: "crouching | standing",
        walk: 0.4,
        stance: "crouching",
        finish_reroutes: {
            crouching: "crouch_hold",
            standing: "crouch_hold"
        },
        phases: {
            // The motion this was rendered from is somebody backing away crouched, so going forwards is it played the other way round
            creep: { animation: "crouch_walk_back", art_speed: 0.5, loop_while: "held", cancel: 0 }
        }
    },

    fall: {
        stances: "falling",
        stance: "falling",
        stance_after: "standing",
        phases: {
            drop: { animation: "falling_idle", start: 1, art_speed: 0.5, loop_while: "falling", cancel: 0 }
        }
    },

    heavy_land: {
        stances: "standing | crouching | falling",
        walk: 0,
        phases: {
            land: { animation: "falling_landing", start: 10, cancel: 12 }
        }
    },

    run: {
        input: "DPadLeft | DPadRight",
        trigger: "held",
        priority: 70,
        stances: "standing",
        finish_reroutes: {
            standing: "idle"
        },
        phases: {
            stride: { animation: "run", art_speed: 0.5, loop_while: "held", cancel: 0 }
        }
    },

    jump: {
        input: "DPadUp",
        trigger: "held",
        priority: 50,
        stances: "standing | crouching",
        finish_reroutes: {
            falling: "fall"
        },
        phases: {
            squat: { animation: "run_jump", start: 3, frames: 3 },
            launch: { frames: 3, jump: "hop", effect: "jump" },
            rise: { animation: "run_jump", start: 9, frames: 6, art_speed: 0.5, loop_while: "jumping", cancel: 0 }
        }
    },

    // Up again in the air, as many times as the character's double_jumps says
    double_jump: {
        input: "DPadUp",
        trigger: "pressed",
        priority: 49,
        stances: "jumping | falling",
        finish_reroutes: {
            falling: "fall"
        },
        phases: {
            flip: { animation: "run_jump", start: 6, frames: 6, jump: "double", effect: "jump" },
            rise: { animation: "run_jump", start: 9, frames: 6, art_speed: 0.5, loop_while: "jumping", cancel: 0 }
        }
    },

    // What an aerial with landing_lag lands in, for as long as it says
    landing: {
        stances: "standing | crouching | jumping | falling",
        walk: 0,
        phases: {
            land: { animation: "falling_landing", start: 10, loop_while: "landing" }
        }
    },

    dodge_roll: {
        input: "DPadLeft | DPadRight",
        trigger: "double_tap",
        priority: 10,
        stances: "standing | crouching",
        walk: 0,
        status: "invulnerable",
        // The art takes a while to get to the floor and tumbles over the middle of it. One shove at the start would have them
        // across the stage before they had bent their knees, so the push comes in three goes, the biggest while they are upside down
        phases: {
            dive: { animation: "roll", start: 14, frames: 9, impulse: vec(522, 0), effect: "roll", effect_frames: 9 },
            tumble: { frames: 10, impulse: vec(675, 0), effect: "roll", effect_frames: 10 },
            over: { frames: 10, impulse: vec(578, 0), effect: "roll", effect_frames: 6 },
            recover: { frames: 9, cancel: 3 }
        }
    },

    /* Blocking and getting hit */

    block: {
        input: "RightBumper",
        trigger: "held",
        priority: 40,
        stances: "standing | crouching",
        walk: 0,
        phases: {
            raise: { animation: "pull_heavy", frames: 4, cancel: 0, commit: 3, status: "blocking", status_frame: 2 },
            hold: { animation: "pull_heavy", start: 4, art_speed: 0.5, loop_while: "held", commit: 0 }
        }
    },

    // They have no animation for being hit. The start of falling over dead is somebody reeling with their arms out, which does
    hit_stun: {
        stances: "standing | crouching | jumping | falling",
        walk: 0,
        finish_reroutes: {
            jumping: "fall",
            falling: "fall"
        },
        phases: {
            reel: { animation: "death_1", start: 3, frames: 14, loop_while: "hitstun", effect: "haze", effect_frames: 0 }
        }
    },

    knocked_out: {
        stances: "standing | crouching | jumping | falling",
        walk: 0,
        phases: {
            drop: { animation: "death_2" },
            down: { frames: 1, loop_while: "always" }
        }
    },

    knocked_down: {
        stances: "standing | crouching | jumping | falling",
        walk: 0,
        finish_reroutes: {
            standing: "get_up",
            crouching: "get_up"
        },
        phases: {
            drop: { animation: "death_1", start: 28, frames: 34 },
            floor: { frames: 1, loop_while: "hitstun" }
        }
    },

    get_up: {
        stances: "standing | crouching",
        walk: 0,
        status: "invulnerable",
        phases: {
            rise: { animation: "get_up" }
        }
    },

    // Getting up out of a knockdown before it happens, block pressed just before landing. On the spot, or rolling the way
    // held (tech_roll), both with i-frames
    tech: {
        stances: "standing | crouching",
        walk: 0,
        status: "invulnerable",
        phases: {
            rise: { animation: "get_up", frames: 20, stretch: true }
        }
    },

    tech_roll: {
        stances: "standing | crouching",
        walk: 0,
        status: "invulnerable",
        phases: {
            roll: { animation: "roll", start: 14, frames: 24, stretch: true, impulse: vec(675, 0), effect: "roll", effect_frames: 6 }
        }
    },

    // Bending down to pick something up off the floor, right where the head of the loser is. All of it, from looking down
    // at them to standing back up straight. The round waits for it to finish
    victory: {
        stances: "standing | crouching",
        walk: 0,
        phases: {
            gloat: { animation: "find_item", start: 198, frames: 164, art_speed: 0.5 }
        }
    },

    /* Punches */

    punch_left: {
        input: "X",
        trigger: "pressed",
        priority: 24,
        stances: "standing | crouching",
        damage: 4,
        hitstun: 12,
        blockstun: 8,
        walk: 0,
        status: "attacking",
        stance_reroutes: {
            crouching: "body_blow"
        },
        phases: {
            swing: { animation: "punch_1", start: 7, frames: 15, hit: 7, active: 2 }
        }
    },

    punch_right: {
        input: "Y",
        trigger: "pressed",
        priority: 34,
        stances: "standing | crouching",
        damage: 9,
        hitstun: 24,
        blockstun: 17,
        push: 24,
        walk: 0,
        status: "attacking",
        stance_reroutes: {
            crouching: "uppercut"
        },
        phases: {
            swing: { animation: "punch_straight", start: 10, frames: 28, hit: 14, active: 3 }
        }
    },

    hook: {
        input: "LeftBumper",
        trigger: "pressed",
        priority: 36,
        stances: "standing",
        damage: 6,
        hitstun: 18,
        blockstun: 12,
        walk: 0,
        status: "attacking",
        phases: {
            swing: { animation: "punch_2", start: 6, frames: 20, hit: 8, active: 1 }
        }
    },

    body_blow: {
        stances: "crouching",
        damage: 5,
        hitstun: 17,
        blockstun: 12,
        walk: 0,
        status: "attacking",
        stance: "crouching",
        finish_reroutes: {
            crouching: "crouch_hold"
        },
        phases: {
            swing: { animation: "punch_quad", start: 4, frames: 20, hit: 7, active: 1 }
        }
    },

    uppercut: {
        stances: "crouching",
        damage: 8,
        hitstun: 38,
        blockstun: 12,
        launch: vec(9, 65),
        hit_cancel: ["jump"],
        walk: 0,
        status: "attacking",
        stance: "crouching",
        finish_reroutes: {
            crouching: "crouch_hold"
        },
        phases: {
            swing: { animation: "punch_3", start: 7, frames: 19, hit: 9, active: 1 }
        }
    },

    /* Kicks */

    kick_left: {
        input: "A",
        trigger: "pressed",
        priority: 20,
        stances: "standing | falling | jumping | crouching",
        damage: 6,
        hitstun: 23,
        blockstun: 16,
        walk: 0,
        status: "attacking",
        stance_reroutes: {
            jumping: "jump_kick",
            falling: "jump_kick",
            crouching: "low_kick"
        },
        phases: {
            swing: { animation: "kick_high", start: 4, frames: 26, hit: 10, active: 1 }
        }
    },

    kick_right: {
        input: "B",
        trigger: "pressed",
        priority: 30,
        stances: "standing | falling | jumping | crouching",
        damage: 10,
        hitstun: 31,
        blockstun: 22,
        push: 28,
        walk: 0,
        status: "attacking",
        stance_reroutes: {
            jumping: "jump_kick",
            falling: "jump_kick",
            crouching: "sweep"
        },
        phases: {
            swing: { animation: "kick_head", start: 6, frames: 32, hit: 11, active: 1 }
        }
    },

    low_kick: {
        stances: "crouching",
        damage: 5,
        hitstun: 20,
        blockstun: 14,
        level: "low",
        walk: 0,
        status: "attacking",
        stance: "crouching",
        finish_reroutes: {
            crouching: "crouch_hold"
        },
        phases: {
            swing: { animation: "kick_low", start: 7, frames: 24, hit: 10, active: 1 }
        }
    },

    sweep: {
        stances: "crouching",
        damage: 8,
        hitstun: 31,
        blockstun: 22,
        launch: vec(11, 28),
        level: "low",
        knockdown: true,
        walk: 0,
        status: "attacking",
        stance: "crouching",
        finish_reroutes: {
            crouching: "crouch_hold"
        },
        phases: {
            swing: { animation: "kick_low", start: 3, frames: 34, hit: 14, active: 1 }
        }
    },

    // The same kick as on the ground, without the part where a foot is planted
    jump_kick: {
        stances: "jumping | falling",
        damage: 8,
        hitstun: 16,
        blockstun: 11,
        launch: vec(24, 35),
        level: "overhead",
        knockdown: true,
        walk: 0,
        landing_lag: 10,
        status: "attacking",
        finish_reroutes: {
            standing: "idle",
            falling: "fall"
        },
        phases: {
            swing: { animation: "kick_high", start: 9, frames: 16, hit: 5, active: 1 }
        }
    },

    /* The ones that cost meter */

    spin_kick: {
        input: "A + B",
        trigger: "pressed",
        priority: 5,
        stances: "standing | crouching",
        damage: 14,
        hitstun: 36,
        blockstun: 25,
        launch: vec(33, 44),
        knockdown: true,
        meter_cost: 25,
        walk: 0,
        status: "attacking",
        phases: {
            wheel: { animation: "kick_spin_high", start: 6, frames: 36, hit: 16, active: 1, impulse: vec(522, 0) }
        }
    },

    // Three phases with a hit each. Every hit is scaled like the next hit of a combo, so the lot comes to about 16
    flurry: {
        input: "X + Y",
        trigger: "pressed",
        priority: 6,
        stances: "standing | crouching",
        damage: 6,
        hitstun: 42,
        blockstun: 29,
        push: 15,
        meter_cost: 25,
        walk: 0,
        status: "attacking",
        phases: {
            jab: { animation: "punch_1", start: 8, frames: 10, hit: 6, active: 1, impulse: vec(389, 0) },
            hook: { animation: "punch_2", start: 8, frames: 10, hit: 6, active: 1, impulse: vec(389, 0) },
            straight: { animation: "punch_straight", start: 14, frames: 24, hit: 10, active: 1, impulse: vec(461, 0) }
        }
    }
}
