// The attacks and the block. The moves for getting around are in movement_moves.hor.
// A character lists the files its moves come from in characters.hor, a move in a later file replaces the one of the same name from an earlier one.
//
// Every number in a move means what it says. A frame is a frame of the fight, 60 a second, whoever plays the move and
// whatever rate their art was drawn at, and a distance is world units (a fighter is about 30 wide and 73 tall, a tile 16).
// hitstun: 20 holds whoever gets hit for exactly 20 frames, launch: vec(20, 90) puts them exactly 90 up.
//
// What a move can have:
//   input             the button that starts it. "DPadLeft | DPadRight" (or ["DPadLeft", "DPadRight"]) is either of them, "A + B" is both together.
//                     The buttons are A, B, X, Y, DPadUp, DPadDown, DPadLeft, DPadRight, LeftBumper, RightBumper, LeftTrigger and RightTrigger.
//                     Which physical button each one sits on is up to the bindings of the player. A move without an input can only be rerouted to.
//   trigger           how the input has to be entered. "held" (for as long as it is), "pressed" (once per press) or "double_tap".
//   priority          the order the inputs are matched in, lowest goes first. A move that needs more than another one has to come before it
//                     (double tap left before left).
//   stances           the stances it can be started from, "standing | crouching | jumping | falling" or a list of them.
//   damage            how much health a hit takes, out of 100.
//   hitstun           how many frames whoever gets hit loses the controls for, exactly. A hit on somebody already in hitstun
//                     replaces what they had left. Leave it out and the game guesses from the startup, Hex shows what it came to.
//   blockstun         how many frames whoever blocks it is stuck in their block for. Leave it out for a share of the hitstun.
//   hitstop           how many frames both of them freeze for when it lands. If it doesn't say, Smash's hitlag, damage * 0.65 + 6
//                     and never more than 30, a block 0.67 of that and a counter hit 4 more. The launch waits for it to end.
//   launch            where whoever gets hit is sent, vec(away, up) in world units. They go up exactly that high from where they
//                     were hit and are that far away by the time they get there, then come down. 30 is off their feet, 75 the
//                     height of a fighter, the height to juggle at. Nothing up is no launch. Whoever is launched turns it a
//                     little with the direction they hold as the hitlag ends (DI).
//   launch_growth     how much further the launch goes for every 10 health they have lost, vec(away, up), less for a heavy
//                     character (weight in characters.hor). At full health the launch is exactly launch. Smash's scaling.
//   push              how far a hit that doesn't launch slides them along the ground, 16 if it doesn't say. The attacker slides
//                     back half of it. In the air it pops them up a little and pushes them that far.
//   hitstun_gravity   how much of their gravity whoever gets hit falls with until their hitstun is over, what their character says
//                     if it doesn't (half, see characters.hor). Less floats them for longer. Every hit of a juggle adds a tenth.
//   level             where the hit comes in. "mid" (blocked standing or crouching, which it is if left out), "low" (only a crouching
//                     block stops it, a sweep) or "overhead" (only a standing block stops it, anything coming down from a jump).
//   knockdown         whether whoever gets hit ends up on the floor. Launched first they go down when they land, otherwise on the spot.
//                     Nothing hits somebody who is down, and they get up with the i-frames of the get_up move.
//   meter_cost        how much of the super meter the move burns to come out, out of 100. Without the meter for it the input is
//                     matched against the next move instead (A + B without the meter for the special is a plain kick).
//   hit_cancel        the moves it can be cancelled into from the frame after its hit lands (or is blocked), whatever its cancel
//                     frames say, by name or by kind. ["jump"] on a launcher is a jump cancel, which is how a launch gets followed
//                     up, ["special", "super"] on a normal is Street Fighter's cancel. "any" for anything.
//   kind              "normal", "special" or "super", which is what a hit cancel by kind goes by. If it doesn't say, a move that
//                     costs meter is a special, half the meter or more a super, and everything else a normal.
//   whiff_lag         how many frames longer the move lasts when its hit came out and missed, and its cancel frames don't count
//                     then either. Swinging at nothing costs, Rivals of Aether's whifflag.
//   walk              how much of their walk speed the player can walk at during it on the ground, 0 to 1, 1 if it doesn't say.
//                     An attack on the ground plants you with walk: 0, creeping along crouched is 0.4.
//   drift             how much of their air speed they can drift at during it in the air, 0 to 1, 1 if it doesn't say. Aerials
//                     keep all of it, the Smash way.
//   turning           whether the player can turn around during the move, yes if they can walk in it unless it says.
//   landing_lag       how many frames of the "landing" move whoever comes down in the middle of it is stuck in. For aerials.
//   status            what the player is while the move lasts. "attacking", "blocking" (hits from the front bounce off and the player
//                     can't turn around) or "invulnerable" (i-frames, hits go straight through).
//   stance            the stance the move puts the player in, and stance_after the one it leaves them in.
//   warns             whether the opponent gets a heads up that the move is coming (the dummy uses it to block). Moves that do damage warn unless they say no.
//   repeat            a condition (see below) under which the move starts over after its last phase.
//   stance_reroutes   another move to do instead, by the stance the player is in when the input comes (kick in the air is a jump kick).
//   finish_reroutes   the move to carry on with once this one is over, by the stance the player is in by then. Without one they go back to "idle".
//   phases            what the move actually does, see below.
//
// The phases of a move play one after the other in the order they are written. What a phase can have:
//   animation         the animation to play, which is a tag of the character's .ase file. Without one the animation of the phase before carries on.
//   start             the frame of the art the phase starts on, 0 if it doesn't say. For an animation that only gets going a few frames in.
//   art_speed         how fast the art plays against the frame rate of the character, 1 if it doesn't say. Art drawn at half of it is 0.5.
//   frames            how many frames the phase lasts, as long as what is left of its art takes if it doesn't say.
//   stretch           whether what is left of the art is spread evenly over the frames of the phase, rather than played at its own pace.
//   hit               the frame the hit comes out on, counted from 0. Everything before it is startup and everything after the active frames is recovery.
//   active            how many frames the hitbox stays out for from the hit frame, 1 if it doesn't say (or what the hitboxes file says).
//   cancel            the frame from which the move can be cancelled into another one. A move without one can't be, it plays out.
//   commit            the frame from which the player is committed and can't cancel any more.
//   status            a status (see above) the player only takes on during this phase, from the frame status_frame says (0 if it doesn't).
//                     It lasts until the move is over.
//   loop_while        a condition. The phase starts over for as long as it holds and ends the frame it stops holding.
//   until             a condition. The phase ends the frame it starts holding.
//   impulse           a shove the player gets as the phase starts, vec(the way they are facing, up), in units a second. There's no drag, on the
//                     ground the traction of the character takes it off again (a speed of v slides v * v / 5600 at the usual 2800).
//   jump              a jump as the phase starts, as high as the character says. "full", "short", "hop" (full if the input is still held,
//                     short if it was let go of, which is what makes a tap a short hop) or "double" (one of the jumps in the air).
//   effect            a bit of eye candy, "jump", "roll" or "haze". effect_frames is how many frames it keeps coming for (1 if it doesn't say, 0 for all of them).
//
// The conditions are "held" (the input of the move is), "hitstun", "jumping" (on the way up), "falling", "landing" (the landing lag
// of an aerial isn't over) and "always".
//
// Eleven names mean something to the game. "idle" is what a player does when they do nothing (and has to be there),
// "hit_stun" is what they are put in while they are in hitstun, "knocked_out" is where they stay once their health is gone
// (without one they stay in "hit_stun"), "heavy_land" is what a long fall ends in if there is one, "landing" is what an aerial
// with landing_lag lands in, "knocked_down" is where they lie after a knockdown (hit_stun without one) and "get_up" is how they
// get back up from it (straight to idle without one), "tech" and "tech_roll" how they get up out of one they teched. "victory" is what the winner of a round plays over whoever they knocked out,
// after walking over to their head with "run". A character without one just stands there like a decent person.
//
// How hits work (the numbers behind all of this are in Combat/CombatRules.cs):
//   - Every hit puts the victim in hitstun for exactly what the move says. They are stuck in "hit_stun" and can't do anything until it runs out.
//   - A move that doesn't say its hitstun gets a guess, a fast move a little minus on hit and a slow one plus enough to link off.
//     Write the number in, the guess is only there so a new move does something.
//   - Somebody launched falls on half their gravity (their character's hitstun_gravity) and can be juggled. Every hit up there makes
//     them a tenth heavier, so a juggle comes down by itself. A launcher with hit_cancel: ["jump"] is how to get up there after them.
//   - A hit that catches somebody in the startup of their own attack is a counter hit. 4 frames more hitstun and more damage.
//   - Both of them freeze when a hit lands (hitstop). Whoever got hit can press a direction during it to shove themselves
//     a little that way (SDI, one press every 4 frames counts) and hold one as it ends to turn the launch (DI).
//   - Somebody knocked down who presses block in the 11 frames before they land techs, they get up on the spot ("tech")
//     or roll the way they hold ("tech_roll") with i-frames instead of lying there. Pressing it too early locks it out.
//   - A block put up 5 frames or fewer before the hit lands is a parry. No chip, no blockstun, and the attacker is stuck
//     for 20 frames.
//   - A move that keeps landing does less. The last 9 moves of a player that landed are remembered and every copy of this
//     one takes a bit off, 9% for the newest down to 1% for the oldest.
//   - A hit that catches somebody in the recovery of their own attack is a punish. Same as a normal hit, but the HUD calls them out for it.
//   - Every hit of a combo after the first does less damage, so a long combo isn't a round by itself.
//   - Blocking only covers the front, and you can't turn around while you are blocking. A block held with down is a crouching block,
//     which is what stops a low. A blocked hit still shoves the blocker back, keeps them in the block for the blockstun and takes a
//     sliver of chip damage (never the last of their health).
//   - Both players build super meter off hits dealt and taken, blocks and even whiffs. The moves that cost meter say so (meter_cost).

let moves = {
    block: {
        input: "RightBumper",
        trigger: "held",
        priority: 40,
        stances: "standing | crouching",
        walk: 0,
        phases: {
            raise: { animation: "block_start", cancel: 0, commit: 8, status: "blocking", status_frame: 5 },
            hold: { animation: "block_loop", loop_while: "held", commit: 0 }
        }
    },

    hit_stun: {
        stances: "standing | crouching | jumping | falling",
        walk: 0,
        finish_reroutes: {
            jumping: "fall",
            falling: "fall"
        },
        phases: {
            dazed: { animation: "hard_landing", frames: 2, loop_while: "hitstun", effect: "haze", effect_frames: 0 }
        }
    },

    knocked_out: {
        stances: "standing | crouching | jumping | falling",
        walk: 0,
        phases: {
            drop: { animation: "knocked_out" },
            down: { frames: 5, loop_while: "always" }
        }
    },

    knocked_down: {
        stances: "standing | crouching | jumping | falling",
        walk: 0,
        finish_reroutes: {
            standing: "get_up",
            crouching: "get_up"
        },
        phases: {
            drop: { animation: "knocked_out" },
            floor: { frames: 5, loop_while: "hitstun" }
        }
    },

    get_up: {
        stances: "standing | crouching",
        walk: 0,
        status: "invulnerable",
        phases: {
            rise: { animation: "hard_landing" }
        }
    },

    // Getting up out of a knockdown before it happens, block pressed just before landing. On the spot, or rolling the way
    // held (tech_roll), both with i-frames
    tech: {
        stances: "standing | crouching",
        walk: 0,
        status: "invulnerable",
        phases: {
            rise: { animation: "hard_landing", frames: 20, stretch: true }
        }
    },

    tech_roll: {
        stances: "standing | crouching",
        walk: 0,
        status: "invulnerable",
        phases: {
            roll: { animation: "roll", frames: 24, stretch: true, impulse: vec(1030, 0), effect: "roll", effect_frames: 6 }
        }
    },

    kick_left: {
        input: "A",
        trigger: "pressed",
        priority: 20,
        stances: "standing | falling | jumping | crouching",
        damage: 5,
        hitstun: 12,
        blockstun: 8,
        walk: 0,
        status: "attacking",
        stance_reroutes: {
            jumping: "jump_kick",
            falling: "jump_kick"
        },
        phases: {
            swing: { animation: "kick", hit: 8, active: 2 }
        }
    },

    kick_right: {
        input: "B",
        trigger: "pressed",
        priority: 30,
        stances: "standing | falling | jumping | crouching",
        damage: 5,
        hitstun: 12,
        blockstun: 8,
        walk: 0,
        status: "attacking",
        stance_reroutes: {
            jumping: "jump_kick",
            falling: "jump_kick"
        },
        phases: {
            swing: { animation: "kick", hit: 8, active: 2 }
        }
    },

    punch_left: {
        input: "X",
        trigger: "pressed",
        priority: 24,
        stances: "standing | crouching",
        damage: 3,
        hitstun: 12,
        blockstun: 8,
        walk: 0,
        status: "attacking",
        phases: {
            swing: { animation: "punch", hit: 5, active: 2 }
        }
    },

    punch_right: {
        input: "Y",
        trigger: "pressed",
        priority: 34,
        stances: "standing | crouching",
        damage: 3,
        hitstun: 12,
        blockstun: 8,
        walk: 0,
        status: "attacking",
        phases: {
            swing: { animation: "punch", hit: 5, active: 2 }
        }
    },

    jump_kick: {
        stances: "jumping | falling",
        damage: 8,
        blockstun: 21,
        launch: vec(24, 35),
        hitstun: 30,
        level: "overhead",
        knockdown: true,
        walk: 0,
        landing_lag: 10,
        status: "attacking",
        finish_reroutes: {
            standing: "idle",
            falling: "fall"
        },
        phases: {
            swing: { animation: "jump_kick", hit: 10, active: 2 }
        }
    }
}