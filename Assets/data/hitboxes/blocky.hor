// The hand drawn hitboxes of blocky, written by the hitbox editor (HitboxEditor/). A move that isn't here hits
// with whatever limb its art has sticking out. min and max are a share of the frame from its middle, x the way the
// character faces and y up, active is how many frames of the move the box stays out for from the hit frame. A move whose
// box changes from one active frame to the next has frames, a box for every one of them from the hit frame on.

let hitboxes = {
    spin_kick: { min: vec(0.0625, -0.1719), max: vec(0.3828, -0.0469), active: 1 },
    uppercut: { min: vec(-0.0078, 0.0078), max: vec(0.1484, 0.2109), active: 1 }
};
