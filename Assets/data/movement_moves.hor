// The moves for getting around. See fighting_moves.hor for what all of this means.

#define fight_move

let moves = {
    idle: {
        stances: "standing",
        stance: "standing",
        phases: {
            stand: { animation: "idle", loop_while: "always", cancel: 0 }
        }
    },

    crouch: {
        input: "DPadDown",
        trigger: "held",
        priority: 60,
        stances: "standing",
        walk: 0,
        stance: "crouching",
        stance_after: "standing",
        phases: {
            duck: { animation: "crouch_start" },
            stay: { animation: "crouch_loop", loop_while: "held", cancel: 0 }
        }
    },

    // Crouching without ducking first, for somebody who is down there already. A crouching attack ends in this,
    // ending in crouch would play the duck all over again with down still held
    crouch_hold: {
        input: "DPadDown",
        trigger: "held",
        priority: 61,
        stances: "crouching",
        walk: 0,
        stance: "crouching",
        stance_after: "standing",
        phases: {
            stay: { animation: "crouch_loop", loop_while: "held", cancel: 0 }
        }
    },

    fall: {
        stances: "falling",
        stance: "falling",
        stance_after: "standing",
        phases: {
            drop: { animation: "fall", loop_while: "falling", cancel: 0 }
        }
    },

    run: {
        input: "DPadLeft | DPadRight",
        trigger: "held",
        priority: 70,
        stances: "standing",
        repeat: "held",
        finish_reroutes: {
            standing: "idle"
        },
        phases: {
            stride: { animation: "run_loop", loop_while: "held", cancel: 0 },
            stop: { animation: "run_stop", until: "held", cancel: 0 }
        }
    },

    jump: {
        input: "DPadUp",
        trigger: "held",
        priority: 50,
        stances: "standing | crouching",
        finish_reroutes: {
            falling: "fall"
        },
        phases: {
            squat: { animation: "jump", frames: 3 },
            launch: { jump: "hop", effect: "jump" },
            rise: { loop_while: "jumping", cancel: 0 }
        }
    },

    // Up again in the air, as many times as the character's double_jumps says
    double_jump: {
        input: "DPadUp",
        trigger: "pressed",
        priority: 49,
        stances: "jumping | falling",
        finish_reroutes: {
            falling: "fall"
        },
        phases: {
            flip: { animation: "jump", jump: "double", effect: "jump" },
            rise: { loop_while: "jumping", cancel: 0 }
        }
    },

    // What an aerial with landing_lag lands in, for as long as it says
    landing: {
        stances: "standing | crouching | jumping | falling",
        walk: 0,
        phases: {
            land: { animation: "hard_landing", loop_while: "landing" }
        }
    },

    dodge_roll: {
        input: "DPadLeft | DPadRight",
        trigger: "double_tap",
        priority: 10,
        stances: "standing | crouching",
        walk: 0,
        status: "invulnerable",
        phases: {
            dive: { animation: "roll", frames: 25, impulse: vec(1030, 0), effect: "roll", effect_frames: 25, cancel: 0 },
            recover: { frames: 20, cancel: 0 }
        }
    }
}
