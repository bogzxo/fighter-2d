// The moves for getting around. See fighting_moves.hor for how a move is written down.

let moves = {
    idle: {
        stances: "standing",
        interruptible: true,
        stance: "standing",
        phases: {
            stand: { animation: "idle", loop_while: "always", interrupt: 0 }
        }
    },

    crouch: {
        input: "DPadDown",
        trigger: "held",
        priority: 60,
        stances: "crouching | standing",
        interruptible: true,
        steering: false,
        stance: "crouching",
        stance_after: "standing",
        phases: {
            duck: { animation: "crouch_start" },
            stay: { animation: "crouch_loop", loop_while: "held", interrupt: 0 }
        }
    },

    fall: {
        stances: "falling",
        interruptible: true,
        stance: "falling",
        stance_after: "standing",
        phases: {
            drop: { animation: "fall", loop_while: "falling", interrupt: 0 }
        }
    },

    run: {
        input: "DPadLeft | DPadRight",
        trigger: "held",
        priority: 70,
        stances: "standing",
        interruptible: true,
        repeat: "held",
        finish_reroutes: {
            standing: "idle"
        },
        phases: {
            stride: { animation: "run_loop", loop_while: "held", interrupt: 0 },
            stop: { animation: "run_stop", until: "held", interrupt: 0 }
        }
    },

    jump: {
        input: "DPadUp",
        trigger: "held",
        priority: 50,
        stances: "standing | crouching",
        interruptible: true,
        finish_reroutes: {
            falling: "fall"
        },
        phases: {
            launch: { animation: "jump", impulse: vec(0, 3500), effect: "jump" },
            rise: { loop_while: "jumping", interrupt: 0 }
        }
    },

    dodge_roll: {
        input: "DPadLeft | DPadRight",
        trigger: "double_tap",
        priority: 10,
        stances: "standing | crouching",
        interruptible: true,
        steering: false,
        status: "invulnerable",
        phases: {
            dive: { animation: "roll", frames: 5, impulse: vec(3500, 0), effect: "roll", effect_frames: 5 },
            recover: { frames: 4, interrupt: 0 }
        }
    }
}
