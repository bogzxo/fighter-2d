            rise: { animation: "crouch_end", cancel: 0 }
        }
    },

    crouch_walk: {
        input: ["DPadDown + DPadLeft", "DPadDown + DPadRight"],
        trigger: "held",
        priority: 55,
        stances: "crouching | standing",
        cancellable: true,
        walk_scale: 0.4,
        stance: "crouching",
        finish_reroutes: {
            crouching: "crouch_hold",
            standing: "crouch_hold"
