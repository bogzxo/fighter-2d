        stance: "crouching",
        stance_after: "standing",
        phases: {
            duck: { animation: "crouch_start", cancel: 0 },
            stay: { animation: "crouch_loop", loop_while: "held", cancel: 0 },
            rise: { animation: "crouch_end", cancel: 0 }
        }
    },

    // Crouching without ducking first, for somebody who is down there already (after a crouching attack, or creeping to a stop)
    crouch_hold: {
        input: "DPadDown",
        trigger: "held",
        priority: 61,
        stances: "crouching",
        cancellable: true,
        steering: false,
        stance: "crouching",
        stance_after: "standing",
        phases: {
